{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/qualitative-judge-output-v1.json",
  "title": "Blinded qualitative-coding judge output",
  "type": "object",
  "required": [
    "judge_prompt_version",
    "judge_model_id",
    "packet_id",
    "run_index",
    "evaluated_at_utc",
    "candidate_scores",
    "preference_groups",
    "panel_limitations"
  ],
  "properties": {
    "judge_prompt_version": {"const": "qc-judge-v1"},
    "judge_model_id": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "run_index": {"type": "integer", "minimum": 1, "maximum": 3},
    "evaluated_at_utc": {"type": "string", "format": "date-time"},
    "candidate_scores": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "blind_id",
          "evidential_support",
          "quote_attribution_fidelity",
          "voice_context_preservation",
          "negative_case_preservation",
          "analytic_contract_fit",
          "codebook_usability",
          "interpretive_usefulness",
          "parsimony",
          "overall_quality",
          "serious_error_flags",
          "disposition",
          "confidence",
          "rationale"
        ],
        "properties": {
          "blind_id": {"type": "string", "pattern": "^B[1-5]$"},
          "evidential_support": {"type": "integer", "minimum": 1, "maximum": 5},
          "quote_attribution_fidelity": {"type": "integer", "minimum": 1, "maximum": 5},
          "voice_context_preservation": {"type": "integer", "minimum": 1, "maximum": 5},
          "negative_case_preservation": {"type": "integer", "minimum": 1, "maximum": 5},
          "analytic_contract_fit": {"type": "integer", "minimum": 1, "maximum": 5},
          "codebook_usability": {"type": "integer", "minimum": 1, "maximum": 5},
          "interpretive_usefulness": {"type": "integer", "minimum": 1, "maximum": 5},
          "parsimony": {"type": "integer", "minimum": 1, "maximum": 5},
          "overall_quality": {"type": "integer", "minimum": 1, "maximum": 5},
          "serious_error_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "fabricated_or_altered_quote",
                "wrong_attribution",
                "unsupported_inference",
                "hidden_source_concentration",
                "lost_negative_case",
                "contextual_flattening",
                "unsupported_abstraction",
                "sensitive_or_diagnostic_inference",
                "inconsistent_codebook",
                "other"
              ]
            },
            "uniqueItems": true
          },
          "disposition": {
            "type": "string",
            "enum": ["accept", "revise", "reject", "escalate"]
          },
          "confidence": {"type": "integer", "minimum": 1, "maximum": 5},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "preference_groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "pattern": "^B[1-5]$"},
        "uniqueItems": true
      }
    },
    "panel_limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}

