{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper_metric_rating.schema.json",
  "title": "Paper-aligned qualitative artifact rating",
  "type": "object",
  "required": [
    "annotation_version",
    "rater_id",
    "evaluator_group",
    "packet_id",
    "corpus_id",
    "evaluation_role",
    "output_id",
    "rated_at_utc",
    "evidential_credibility",
    "voice_boundary_preservation",
    "scope_calibration",
    "cannot_judge",
    "confidence",
    "disposition",
    "serious_error_flags",
    "review_seconds",
    "rationale"
  ],
  "properties": {
    "annotation_version": {
      "const": "qc-paper-metrics-v1"
    },
    "rater_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_group": {
      "enum": [
        "researcher",
        "qualitative_methods_expert",
        "domain_expert",
        "dual_expertise"
      ]
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_role": {
      "enum": [
        "development",
        "in_domain_audit",
        "cross_domain_confirmatory"
      ]
    },
    "output_id": {
      "type": "string",
      "minLength": 1
    },
    "rated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "evidential_credibility": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "voice_boundary_preservation": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "scope_calibration": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 5
    },
    "cannot_judge": {
      "type": "array",
      "items": {
        "enum": [
          "evidential_credibility",
          "voice_boundary_preservation",
          "scope_calibration"
        ]
      },
      "uniqueItems": true
    },
    "confidence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "disposition": {
      "enum": ["accept", "revise", "reject", "escalate"]
    },
    "serious_error_flags": {
      "type": "array",
      "items": {
        "enum": [
          "fabricated_or_altered_quote",
          "wrong_attribution",
          "unsupported_inference",
          "hidden_source_concentration",
          "lost_negative_case",
          "contextual_flattening",
          "unsupported_abstraction",
          "sensitive_or_diagnostic_inference",
          "inconsistent_codebook",
          "other"
        ]
      },
      "uniqueItems": true
    },
    "review_seconds": {
      "type": "number",
      "minimum": 0
    },
    "requested_expertise": {
      "enum": ["qualitative_methods", "domain", "both", "none"]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"evidential_credibility": {"type": "null"}}
      },
      "then": {
        "properties": {
          "cannot_judge": {"contains": {"const": "evidential_credibility"}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "cannot_judge": {"contains": {"const": "evidential_credibility"}}
        }
      },
      "then": {
        "properties": {"evidential_credibility": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {"voice_boundary_preservation": {"type": "null"}}
      },
      "then": {
        "properties": {
          "cannot_judge": {"contains": {"const": "voice_boundary_preservation"}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "cannot_judge": {"contains": {"const": "voice_boundary_preservation"}}
        }
      },
      "then": {
        "properties": {"voice_boundary_preservation": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {"scope_calibration": {"type": "null"}}
      },
      "then": {
        "properties": {
          "cannot_judge": {"contains": {"const": "scope_calibration"}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "cannot_judge": {"contains": {"const": "scope_calibration"}}
        }
      },
      "then": {
        "properties": {"scope_calibration": {"type": "null"}}
      }
    }
  ],
  "additionalProperties": false
}
