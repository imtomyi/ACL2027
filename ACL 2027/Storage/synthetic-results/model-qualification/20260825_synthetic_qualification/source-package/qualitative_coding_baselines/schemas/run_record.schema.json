{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/qualitative-run-record-v1.json",
  "title": "Qualitative-coding model run record",
  "type": "object",
  "required": [
    "run_record_version",
    "qualification_scope",
    "model_id",
    "run_index",
    "packet_id",
    "prompt_version",
    "schema_version",
    "generated_at_utc",
    "output"
  ],
  "properties": {
    "run_record_version": {"const": "1.0"},
    "qualification_scope": {"const": "synthetic_only"},
    "model_id": {"type": "string", "minLength": 1},
    "run_index": {"type": "integer", "minimum": 1, "maximum": 3},
    "packet_id": {"type": "string", "minLength": 1},
    "prompt_version": {"const": "qc-direct-v1"},
    "schema_version": {"const": "qualitative-output-v1"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "runtime": {
      "type": "object",
      "properties": {
        "surface": {"type": "string"},
        "reasoning_effort": {"type": "string"},
        "temperature": {"type": ["number", "null"]},
        "seed": {"type": ["integer", "null"]},
        "usage_available": {"type": "boolean"},
        "latency_available": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "output": {"$ref": "qualitative_output.schema.json"}
  },
  "additionalProperties": false
}

