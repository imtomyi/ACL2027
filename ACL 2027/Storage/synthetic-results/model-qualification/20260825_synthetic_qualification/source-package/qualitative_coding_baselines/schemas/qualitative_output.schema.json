{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/qualitative-output-v1.json",
  "title": "Bounded qualitative-coding output",
  "type": "object",
  "required": [
    "packet_id",
    "research_question",
    "analysis_summary",
    "codes",
    "assignments",
    "themes",
    "negative_cases",
    "reflexive_memo"
  ],
  "properties": {
    "packet_id": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "analysis_summary": {"type": "string", "minLength": 1},
    "codes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "code_id",
          "label",
          "definition",
          "inclusion_rule",
          "exclusion_rule",
          "analytic_level",
          "exemplars"
        ],
        "properties": {
          "code_id": {"type": "string", "pattern": "^C[0-9]{2}$"},
          "label": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "inclusion_rule": {"type": "string", "minLength": 1},
          "exclusion_rule": {"type": "string", "minLength": 1},
          "analytic_level": {
            "type": "string",
            "enum": ["manifest", "categorical", "latent_with_explicit_warrant"]
          },
          "exemplars": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {"$ref": "#/$defs/citation"}
          }
        },
        "additionalProperties": false
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["excerpt_id", "code_ids", "not_coded", "rationale"],
        "properties": {
          "excerpt_id": {"type": "string", "minLength": 1},
          "code_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^C[0-9]{2}$"},
            "uniqueItems": true
          },
          "not_coded": {"type": "boolean"},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "themes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "theme_id",
          "name",
          "claim",
          "explanation",
          "code_ids",
          "evidence",
          "counterevidence",
          "boundary_conditions",
          "source_ids",
          "confidence"
        ],
        "properties": {
          "theme_id": {"type": "string", "pattern": "^T[0-9]{2}$"},
          "name": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "explanation": {"type": "string", "minLength": 1},
          "code_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^C[0-9]{2}$"},
            "uniqueItems": true
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {"$ref": "#/$defs/warrantedCitation"}
          },
          "counterevidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"$ref": "#/$defs/warrantedCitation"}
          },
          "boundary_conditions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {"type": "string", "minLength": 1}
          },
          "source_ids": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "confidence": {"type": "integer", "minimum": 1, "maximum": 5}
        },
        "additionalProperties": false
      }
    },
    "negative_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["excerpt_id", "source_id", "quote", "implication"],
        "properties": {
          "excerpt_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "implication": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "reflexive_memo": {
      "type": "object",
      "required": ["uncertainties", "alternative_interpretations", "limitations"],
      "properties": {
        "uncertainties": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1}
        },
        "alternative_interpretations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1}
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["excerpt_id", "source_id", "quote"],
      "properties": {
        "excerpt_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "warrantedCitation": {
      "type": "object",
      "required": ["excerpt_id", "source_id", "quote", "warrant"],
      "properties": {
        "excerpt_id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1},
        "warrant": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

