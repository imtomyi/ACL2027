\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Dataset inventory at the current preparation stage. Dreaddit and CaCHe eligible counts apply deterministic content rules but remain pending manual privacy review and project authorization. CaSiNo source counts use ordinary messages and whitespace delimited words and exclude 2,378 structured negotiation events. AMI counts upstream speech segment and orthographic word XML elements. Source only rows are neither processed nor sampling eligible, and the differing unit types are not common analysis denominators.}}{5}{table.caption.5}\protected@file@percent }
\newlabel{tab:dataset_statistics}{{1}{5}{Dataset inventory at the current preparation stage. Dreaddit and CaCHe eligible counts apply deterministic content rules but remain pending manual privacy review and project authorization. CaSiNo source counts use ordinary messages and whitespace delimited words and exclude 2,378 structured negotiation events. AMI counts upstream speech segment and orthographic word XML elements. Source only rows are neither processed nor sampling eligible, and the differing unit types are not common analysis denominators}{table.caption.5}{}}
