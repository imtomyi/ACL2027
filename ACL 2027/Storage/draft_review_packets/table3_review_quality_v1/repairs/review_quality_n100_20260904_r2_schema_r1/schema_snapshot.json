{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed four-field review-quality judge response v1 revision 3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "credibility",
    "conformability",
    "credibility_rationale",
    "conformability_rationale"
  ],
  "properties": {
    "credibility": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "conformability": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "credibility_rationale": {
      "$ref": "#/$defs/rationale"
    },
    "conformability_rationale": {
      "$ref": "#/$defs/rationale"
    }
  },
  "$defs": {
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    }
  },
  "$comment": "The runner must additionally check the 60-word limit, actual IDs, and request identity. Schema validity does not verify rubric correctness. Null decisions require a substantive missing-context explanation."
}
