{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-j/evaluator-item-v1.json",
  "title": "Direction J blinded evaluator item",
  "description": "The exact one-item theme-and-evidence payload shown to either a human rater or an LLM rater. Private condition, candidate identity, generation, and adjudication metadata are intentionally excluded.",
  "type": "object",
  "required": [
    "item_schema_version",
    "item_id",
    "packet_id",
    "output_id",
    "corpus_id",
    "research_question",
    "analytic_contract",
    "context_note",
    "proposed_interpretation",
    "evidence",
    "source_coverage"
  ],
  "properties": {
    "item_schema_version": {
      "const": "direction-j-evaluator-item-v1"
    },
    "item_id": {
      "type": "string",
      "pattern": "^DJI_[a-f0-9]{16}$",
      "description": "Opaque, study-specific item identifier. It must not reveal the controlled condition or candidate identity."
    },
    "packet_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque evidence-packet identifier shared by paired observations."
    },
    "output_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier for the candidate output from which this theme-level item was derived."
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1,
      "description": "Approved corpus label or blinded corpus label shown identically to all evaluator kinds."
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "analytic_contract": {
      "type": "object",
      "required": [
        "contract_id",
        "contract_version",
        "task_description",
        "validity_rules"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "string",
          "minLength": 1
        },
        "task_description": {
          "type": "string",
          "minLength": 1
        },
        "validity_rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "context_note": {
      "type": "string",
      "minLength": 1
    },
    "proposed_interpretation": {
      "type": "object",
      "required": [
        "theme_id",
        "theme_name",
        "claim",
        "explanation",
        "boundary_conditions"
      ],
      "properties": {
        "theme_id": {
          "type": "string",
          "minLength": 1
        },
        "theme_name": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "boundary_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceEntry"
      }
    },
    "source_coverage": {
      "type": "object",
      "required": [
        "presented_excerpt_count",
        "presented_source_count",
        "candidate_cited_excerpt_count",
        "candidate_cited_source_count",
        "sampling_frame_excerpt_count",
        "sampling_frame_source_count",
        "source_distribution",
        "coverage_note"
      ],
      "properties": {
        "presented_excerpt_count": {
          "type": "integer",
          "minimum": 1
        },
        "presented_source_count": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_cited_excerpt_count": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_cited_source_count": {
          "type": "integer",
          "minimum": 0
        },
        "sampling_frame_excerpt_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sampling_frame_source_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_distribution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "presented_excerpt_count",
              "candidate_cited_excerpt_count"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "presented_excerpt_count": {
                "type": "integer",
                "minimum": 1
              },
              "candidate_cited_excerpt_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "coverage_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "evidenceEntry": {
      "type": "object",
      "required": [
        "display_order",
        "excerpt_id",
        "source_id",
        "speaker_id",
        "local_context",
        "text",
        "candidate_role",
        "candidate_attributed_excerpt_id",
        "candidate_attributed_source_id",
        "candidate_attributed_speaker_id",
        "candidate_quote",
        "candidate_warrant"
      ],
      "properties": {
        "display_order": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "speaker_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_context": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "candidate_role": {
          "enum": [
            "support",
            "counterevidence",
            "context_only"
          ],
          "description": "How the candidate output used the displayed source. This is not an adjudicated truth label."
        },
        "candidate_attributed_excerpt_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Excerpt identifier asserted by the candidate for this citation. It is separate from the actual displayed excerpt_id so attribution errors remain visible."
        },
        "candidate_attributed_source_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source identifier asserted by the candidate for this citation. It is separate from the actual displayed source_id so attribution errors remain visible."
        },
        "candidate_attributed_speaker_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Speaker identifier explicitly asserted by the candidate, or null when the candidate did not state one. It never replaces the actual displayed speaker_id."
        },
        "candidate_quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_warrant": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "candidate_role": {
                "const": "context_only"
              }
            },
            "required": [
              "candidate_role"
            ]
          },
          "then": {
            "properties": {
              "candidate_attributed_excerpt_id": {
                "type": "null"
              },
              "candidate_attributed_source_id": {
                "type": "null"
              },
              "candidate_attributed_speaker_id": {
                "type": "null"
              },
              "candidate_quote": {
                "type": "null"
              },
              "candidate_warrant": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "candidate_attributed_excerpt_id": {
                "type": "string",
                "minLength": 1
              },
              "candidate_attributed_source_id": {
                "type": "string",
                "minLength": 1
              },
              "candidate_quote": {
                "type": "string",
                "minLength": 1
              },
              "candidate_warrant": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
