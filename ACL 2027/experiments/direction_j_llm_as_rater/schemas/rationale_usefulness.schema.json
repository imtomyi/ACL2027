{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-j/rationale-usefulness-v1.json",
  "title": "Direction J blinded rationale-usefulness judgment",
  "type": "object",
  "required": [
    "rationale_rating_version",
    "rationale_packet_id",
    "item_id",
    "evaluator_id",
    "rated_at_utc",
    "source_localization",
    "diagnostic_correctness",
    "bounded_actionability",
    "ambiguity_and_material_preservation",
    "cannot_judge",
    "safe_to_send_to_revision",
    "review_seconds",
    "rationale"
  ],
  "properties": {
    "rationale_rating_version": {
      "const": "direction-j-rationale-usefulness-v1"
    },
    "rationale_packet_id": {
      "type": "string",
      "minLength": 1
    },
    "item_id": {
      "type": "string",
      "pattern": "^DJI_[a-f0-9]{16}$"
    },
    "evaluator_id": {
      "type": "string",
      "minLength": 1
    },
    "rated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_localization": {
      "$ref": "#/$defs/nullable_scale"
    },
    "diagnostic_correctness": {
      "$ref": "#/$defs/nullable_scale"
    },
    "bounded_actionability": {
      "$ref": "#/$defs/nullable_scale"
    },
    "ambiguity_and_material_preservation": {
      "$ref": "#/$defs/nullable_scale"
    },
    "cannot_judge": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "source_localization",
          "diagnostic_correctness",
          "bounded_actionability",
          "ambiguity_and_material_preservation",
          "safe_to_send_to_revision"
        ]
      }
    },
    "safe_to_send_to_revision": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "review_seconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 3600
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "$defs": {
    "nullable_scale": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 5
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "cannot_judge": {
            "contains": {
              "const": "source_localization"
            }
          }
        }
      },
      "then": {
        "properties": {
          "source_localization": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "source_localization": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cannot_judge": {
            "contains": {
              "const": "diagnostic_correctness"
            }
          }
        }
      },
      "then": {
        "properties": {
          "diagnostic_correctness": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "diagnostic_correctness": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cannot_judge": {
            "contains": {
              "const": "bounded_actionability"
            }
          }
        }
      },
      "then": {
        "properties": {
          "bounded_actionability": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "bounded_actionability": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cannot_judge": {
            "contains": {
              "const": "ambiguity_and_material_preservation"
            }
          }
        }
      },
      "then": {
        "properties": {
          "ambiguity_and_material_preservation": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "ambiguity_and_material_preservation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cannot_judge": {
            "contains": {
              "const": "safe_to_send_to_revision"
            }
          }
        }
      },
      "then": {
        "properties": {
          "safe_to_send_to_revision": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "safe_to_send_to_revision": {
            "type": "boolean"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
