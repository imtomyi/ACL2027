{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-direction-j-downstream-gate-v1.json",
  "title": "Fail-closed downstream gate for the Direction H to Direction J bridge",
  "description": "Machine-readable proof that the first-stage compatibility bridge is qualification-only and cannot support feedback-effect claims until a theme-level revision and repair protocol is prospectively frozen.",
  "type": "object",
  "required": [
    "gate_version",
    "bridge_id",
    "status",
    "qualification_only",
    "first_stage_collection_allowed",
    "model_calls_allowed",
    "revision_outputs_allowed",
    "repair_assessments_allowed",
    "empirical_feedback_effect_claims_allowed",
    "old_direction_h_full_output_revision_compatible",
    "blockers",
    "unlock_rule"
  ],
  "properties": {
    "gate_version": {
      "const": "direction-h-direction-j-downstream-gate-v1"
    },
    "bridge_id": {
      "const": "direction-h-direction-j-synthetic-qualification-v1"
    },
    "status": {
      "const": "blocked_pending_prospective_theme_level_extension"
    },
    "qualification_only": {
      "const": true
    },
    "first_stage_collection_allowed": {
      "const": false
    },
    "model_calls_allowed": {
      "const": false
    },
    "revision_outputs_allowed": {
      "const": false
    },
    "repair_assessments_allowed": {
      "const": false
    },
    "empirical_feedback_effect_claims_allowed": {
      "const": false
    },
    "old_direction_h_full_output_revision_compatible": {
      "const": false
    },
    "blockers": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "prospective_queue_activation_decision_missing",
          "direction_j_browser_timing_instrument_missing",
          "independent_itemwise_target_verification_missing",
          "theme_level_paired_revision_case_schema_missing",
          "theme_level_revision_prompt_and_model_freeze_missing",
          "theme_level_arm_blind_repair_panel_missing",
          "theme_level_assignment_and_lock_workflow_missing"
        ]
      }
    },
    "unlock_rule": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
