{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-direction-j-browser-activation-v1.json",
  "title": "Coordinator activation for the Direction H browser instrument on the Direction J queue",
  "description": "The checked-in template is deliberately incomplete. A reviewer cannot activate this queue. An operational record must be completed prospectively by a non-Charlie coordinator and bind the exact frozen browser manifest and Direction J queue.",
  "type": "object",
  "required": [
    "activation_version",
    "record_status",
    "activation_id",
    "phase_id",
    "selected_queue",
    "retired_queue",
    "coordinator_actor_id",
    "coordinator_is_charlie",
    "activated_at_utc",
    "responses_absent_at_activation",
    "outcomes_inspected_before_activation",
    "charlie_authorization_recorded",
    "charlie_qualification_gate_satisfied",
    "synthetic_only",
    "locks",
    "decision_rationale"
  ],
  "properties": {
    "activation_version": {
      "const": "direction-h-direction-j-browser-activation-v1"
    },
    "record_status": {
      "enum": ["template_incomplete", "activated"]
    },
    "activation_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 160
    },
    "phase_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 160
    },
    "selected_queue": {
      "type": ["string", "null"],
      "enum": ["direction_j_exact_charlie_rep1_browser_v1", null]
    },
    "retired_queue": {
      "type": ["string", "null"],
      "enum": ["direction_h_internal_four_item_workflow_qualification", null]
    },
    "coordinator_actor_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 160,
      "not": {"const": "charlie"}
    },
    "coordinator_is_charlie": {
      "type": ["boolean", "null"]
    },
    "activated_at_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "responses_absent_at_activation": {
      "type": ["boolean", "null"]
    },
    "outcomes_inspected_before_activation": {
      "type": ["boolean", "null"]
    },
    "charlie_authorization_recorded": {
      "type": ["boolean", "null"]
    },
    "charlie_qualification_gate_satisfied": {
      "type": ["boolean", "null"]
    },
    "synthetic_only": {
      "type": ["boolean", "null"]
    },
    "locks": {
      "type": "object",
      "required": [
        "browser_manifest_sha256",
        "direction_j_run_manifest_sha256",
        "evaluator_items_sha256",
        "charlie_assignment_sha256",
        "shared_rater_guide_sha256",
        "shared_rating_schema_sha256",
        "actor_registry_sha256",
        "comprehension_record_sha256"
      ],
      "properties": {
        "browser_manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
        "direction_j_run_manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
        "evaluator_items_sha256": {"$ref": "#/$defs/nullableSha256"},
        "charlie_assignment_sha256": {"$ref": "#/$defs/nullableSha256"},
        "shared_rater_guide_sha256": {"$ref": "#/$defs/nullableSha256"},
        "shared_rating_schema_sha256": {"$ref": "#/$defs/nullableSha256"}
        ,"actor_registry_sha256": {"$ref": "#/$defs/nullableSha256"}
        ,"comprehension_record_sha256": {"$ref": "#/$defs/nullableSha256"}
      },
      "additionalProperties": false
    },
    "decision_rationale": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"record_status": {"const": "activated"}},
        "required": ["record_status"]
      },
      "then": {
        "properties": {
          "activation_id": {"type": "string"},
          "phase_id": {"type": "string"},
          "selected_queue": {"const": "direction_j_exact_charlie_rep1_browser_v1"},
          "retired_queue": {"const": "direction_h_internal_four_item_workflow_qualification"},
          "coordinator_actor_id": {"type": "string", "not": {"const": "charlie"}},
          "coordinator_is_charlie": {"const": false},
          "activated_at_utc": {"type": "string"},
          "responses_absent_at_activation": {"const": true},
          "outcomes_inspected_before_activation": {"const": false},
          "charlie_authorization_recorded": {"const": true},
          "charlie_qualification_gate_satisfied": {"const": true},
          "synthetic_only": {"const": true},
          "locks": {
            "properties": {
              "browser_manifest_sha256": {"$ref": "#/$defs/sha256"},
              "direction_j_run_manifest_sha256": {"$ref": "#/$defs/sha256"},
              "evaluator_items_sha256": {"$ref": "#/$defs/sha256"},
              "charlie_assignment_sha256": {"$ref": "#/$defs/sha256"},
              "shared_rater_guide_sha256": {"$ref": "#/$defs/sha256"},
              "shared_rating_schema_sha256": {"$ref": "#/$defs/sha256"}
              ,"actor_registry_sha256": {"$ref": "#/$defs/sha256"}
              ,"comprehension_record_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "decision_rationale": {"type": "string"}
        }
      },
      "else": {
        "properties": {
          "activation_id": {"type": "null"},
          "phase_id": {"type": "null"},
          "selected_queue": {"type": "null"},
          "retired_queue": {"type": "null"},
          "coordinator_actor_id": {"type": "null"},
          "coordinator_is_charlie": {"type": "null"},
          "activated_at_utc": {"type": "null"},
          "responses_absent_at_activation": {"type": "null"},
          "outcomes_inspected_before_activation": {"type": "null"},
          "charlie_authorization_recorded": {"type": "null"},
          "charlie_qualification_gate_satisfied": {"type": "null"},
          "synthetic_only": {"type": "null"},
          "locks": {
            "properties": {
              "browser_manifest_sha256": {"type": "null"},
              "direction_j_run_manifest_sha256": {"type": "null"},
              "evaluator_items_sha256": {"type": "null"},
              "charlie_assignment_sha256": {"type": "null"},
              "shared_rater_guide_sha256": {"type": "null"},
              "shared_rating_schema_sha256": {"type": "null"}
              ,"actor_registry_sha256": {"type": "null"}
              ,"comprehension_record_sha256": {"type": "null"}
            }
          },
          "decision_rationale": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
