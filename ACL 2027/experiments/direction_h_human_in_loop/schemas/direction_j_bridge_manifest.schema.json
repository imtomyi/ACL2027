{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-direction-j-bridge-manifest-v1.json",
  "title": "Frozen Direction H to Direction J compatibility bridge",
  "type": "object",
  "required": [
    "bridge_manifest_version",
    "bridge_id",
    "created_at_utc",
    "status",
    "data_scope",
    "contains_real_source_text",
    "ratings_collected",
    "outcomes_available",
    "activation_rule",
    "non_overlap",
    "direction_h_case",
    "upstream_direction_j",
    "contracts",
    "response_layout"
  ],
  "properties": {
    "bridge_manifest_version": {
      "const": "direction-h-direction-j-bridge-manifest-v1"
    },
    "bridge_id": {
      "const": "direction-h-direction-j-synthetic-qualification-v1"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "const": "prepared_not_activated_or_run"
    },
    "data_scope": {
      "const": "synthetic_qualification_only"
    },
    "contains_real_source_text": {
      "const": false
    },
    "ratings_collected": {
      "const": 0
    },
    "outcomes_available": {
      "const": false
    },
    "activation_rule": {
      "type": "string",
      "minLength": 1
    },
    "non_overlap": {
      "type": "object",
      "required": [
        "relationship_to_direction_h_four_item_pilot",
        "same_charlie_may_run_both_in_one_phase",
        "pool_ratings_across_queues",
        "reason"
      ],
      "properties": {
        "relationship_to_direction_h_four_item_pilot": {
          "const": "prospective_supersession_option_not_add_on"
        },
        "same_charlie_may_run_both_in_one_phase": {
          "const": false
        },
        "pool_ratings_across_queues": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "direction_h_case": {
      "type": "object",
      "required": [
        "direction_j_actor_id",
        "direction_h_case_id",
        "case_role",
        "construction_involved",
        "independent_human_pool_eligible",
        "universal_ground_truth"
      ],
      "properties": {
        "direction_j_actor_id": {
          "const": "charlie"
        },
        "direction_h_case_id": {
          "const": "charlie_dev_researcher_01"
        },
        "case_role": {
          "const": "developer_researcher_case_baseline"
        },
        "construction_involved": {
          "const": true
        },
        "independent_human_pool_eligible": {
          "const": false
        },
        "universal_ground_truth": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "upstream_direction_j": {
      "type": "object",
      "required": [
        "study_id",
        "run_id",
        "run_manifest",
        "freeze",
        "evaluator_items",
        "charlie_assignment",
        "expected_item_count",
        "expected_assignment_count",
        "rating_repetition",
        "evaluation_role",
        "qualification_blinding_strength"
      ],
      "properties": {
        "study_id": {
          "const": "direction-j-v1"
        },
        "run_id": {
          "const": "20260825_synthetic_paired_qualification_prepared"
        },
        "run_manifest": {
          "$ref": "#/$defs/fileLock"
        },
        "freeze": {
          "$ref": "#/$defs/fileLock"
        },
        "evaluator_items": {
          "$ref": "#/$defs/fileLock"
        },
        "charlie_assignment": {
          "$ref": "#/$defs/fileLock"
        },
        "expected_item_count": {
          "const": 24
        },
        "expected_assignment_count": {
          "const": 24
        },
        "rating_repetition": {
          "const": 1
        },
        "evaluation_role": {
          "const": "synthetic_qualification"
        },
        "qualification_blinding_strength": {
          "const": "operational_mount_isolation_not_secure_against_workspace_reader"
        }
      },
      "additionalProperties": false
    },
    "contracts": {
      "type": "object",
      "required": [
        "interface_version",
        "item_schema_version",
        "rating_schema_version",
        "shared_rater_guide_version",
        "evaluator_item_schema",
        "shared_rating_schema",
        "shared_rater_guide",
        "human_instrument",
        "bridge_manifest_schema",
        "base_direction_h_feedback_schema",
        "feedback_schema",
        "review_receipt_schema",
        "collector",
        "validator",
        "protocol",
        "downstream_gate_schema",
        "downstream_gate",
        "activation_schema",
        "activation_template"
      ],
      "properties": {
        "interface_version": {
          "const": "direction-j-shared-interface-v1"
        },
        "item_schema_version": {
          "const": "direction-j-evaluator-item-v1"
        },
        "rating_schema_version": {
          "const": "direction-j-shared-rating-v1"
        },
        "shared_rater_guide_version": {
          "const": "direction-j-rater-guide-v1"
        },
        "evaluator_item_schema": {
          "$ref": "#/$defs/fileLock"
        },
        "shared_rating_schema": {
          "$ref": "#/$defs/fileLock"
        },
        "shared_rater_guide": {
          "$ref": "#/$defs/fileLock"
        },
        "human_instrument": {
          "$ref": "#/$defs/fileLock"
        },
        "bridge_manifest_schema": {
          "$ref": "#/$defs/fileLock"
        },
        "base_direction_h_feedback_schema": {
          "$ref": "#/$defs/fileLock"
        },
        "feedback_schema": {
          "$ref": "#/$defs/fileLock"
        },
        "review_receipt_schema": {
          "$ref": "#/$defs/fileLock"
        },
        "collector": {
          "$ref": "#/$defs/fileLock"
        },
        "validator": {
          "$ref": "#/$defs/fileLock"
        },
        "protocol": {
          "$ref": "#/$defs/fileLock"
        },
        "downstream_gate_schema": {
          "$ref": "#/$defs/fileLock"
        },
        "downstream_gate": {
          "$ref": "#/$defs/fileLock"
        },
        "activation_schema": {
          "$ref": "#/$defs/fileLock"
        },
        "activation_template": {
          "$ref": "#/$defs/fileLock"
        }
      },
      "additionalProperties": false
    },
    "response_layout": {
      "type": "object",
      "required": [
        "root",
        "rating_directory",
        "feedback_directory",
        "receipt_directory",
        "commit_unit",
        "rating_representation",
        "paired_observation_generation"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "rating_directory": {
          "type": "string",
          "minLength": 1
        },
        "feedback_directory": {
          "type": "string",
          "minLength": 1
        },
        "receipt_directory": {
          "type": "string",
          "minLength": 1
        },
        "commit_unit": {
          "const": "atomic_rating_feedback_receipt_triplet"
        },
        "rating_representation": {
          "const": "unwrapped_exact_direction-j-shared-rating-v1"
        },
        "paired_observation_generation": {
          "const": "coordinator_only_after_review_lock_and_private_join"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "fileLock": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
