{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-pilot-item-v1.json",
  "title": "Direction H reviewer-safe synthetic pilot item",
  "description": "The complete item shown to a reviewer. It contains no condition, target truth, source run index, blind-map identifier, model identity, historical score, or outcome.",
  "type": "object",
  "required": [
    "pilot_item_version",
    "study_id",
    "task_id",
    "display_order",
    "packet_id",
    "corpus_id",
    "evaluation_role",
    "output_id",
    "data_classification",
    "evidence_packet",
    "candidate_output"
  ],
  "properties": {
    "pilot_item_version": {"const": "direction-h-pilot-item-v1"},
    "study_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "display_order": {"type": "integer", "minimum": 1},
    "packet_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "corpus_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "evaluation_role": {"const": "development"},
    "output_id": {
      "description": "Stable blinded identifier used unchanged in canonical human and LLM rating records.",
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "data_classification": {"const": "synthetic_cc0"},
    "evidence_packet": {"$ref": "#/$defs/evidencePacket"},
    "candidate_output": {
      "$ref": "https://warrantroute.local/schemas/qualitative-output-v1.json"
    }
  },
  "$defs": {
    "excerpt": {
      "type": "object",
      "required": ["excerpt_id", "source_id", "speaker_id", "context", "text"],
      "properties": {
        "excerpt_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "speaker_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
        "context": {"type": "string", "maxLength": 2000},
        "text": {"type": "string", "minLength": 1, "maxLength": 20000}
      },
      "additionalProperties": false
    },
    "evidencePacket": {
      "type": "object",
      "required": [
        "packet_id",
        "corpus_proxy",
        "status",
        "research_question",
        "context_note",
        "excerpts"
      ],
      "properties": {
        "packet_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "corpus_proxy": {"type": "string", "minLength": 1, "maxLength": 160},
        "status": {"const": "synthetic_proxy_not_corpus_result"},
        "research_question": {"type": "string", "minLength": 1, "maxLength": 4000},
        "context_note": {"type": "string", "minLength": 1, "maxLength": 4000},
        "excerpts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/excerpt"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
