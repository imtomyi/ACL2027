{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-post-revision-rating-link-v1.json",
  "title": "Direction H post-revision rating link",
  "description": "Reviewer-safe linkage between one exact qc-paper-metrics-v1 post-revision rating and its separately preserved Direction H repair assessment. This record intentionally omits feedback arm, feedback author, model identity, condition labels, diagnoses, and outcomes beyond those already present in the linked assessment.",
  "type": "object",
  "required": [
    "link_version",
    "link_id",
    "study_id",
    "task_id",
    "blinded_revision_id",
    "assessment_id",
    "rating_key",
    "repair_assessment_record_sha256",
    "post_revision_rating_record_sha256",
    "shared_rating_schema_sha256",
    "hash_serialization",
    "timing",
    "linked_at_utc"
  ],
  "properties": {
    "link_version": {"const": "direction-h-post-revision-rating-link-v1"},
    "link_id": {"type": "string", "pattern": "^DHL-[0-9A-F]{20}$"},
    "study_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "blinded_revision_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "assessment_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "rating_key": {
      "type": "object",
      "required": [
        "annotation_version",
        "rater_id",
        "packet_id",
        "corpus_id",
        "evaluation_role",
        "output_id",
        "rated_at_utc"
      ],
      "properties": {
        "annotation_version": {"const": "qc-paper-metrics-v1"},
        "rater_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "packet_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "corpus_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "evaluation_role": {
          "enum": ["development", "in_domain_audit", "cross_domain_confirmatory"]
        },
        "output_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "rated_at_utc": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "repair_assessment_record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "post_revision_rating_record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "shared_rating_schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hash_serialization": {
      "const": "utf8_json_sorted_keys_compact_plus_lf_v1"
    },
    "timing": {
      "description": "Both record timers share the instant immediately before complete-item display. The rating timer is cumulative through the later metric phase; incremental_metric_phase_seconds isolates only the post-component metric-entry interval and is not a cold-review duration.",
      "type": "object",
      "required": [
        "timer_origin",
        "collection_order",
        "repair_assessment_review_seconds",
        "post_revision_rating_review_seconds",
        "incremental_metric_phase_seconds"
      ],
      "properties": {
        "timer_origin": {"const": "immediately_before_complete_item_display"},
        "collection_order": {"const": "repair_components_then_shared_metrics"},
        "repair_assessment_review_seconds": {"type": "number", "minimum": 0},
        "post_revision_rating_review_seconds": {"type": "number", "minimum": 0},
        "incremental_metric_phase_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "linked_at_utc": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
