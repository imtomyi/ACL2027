{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-direction-j-browser-manifest-v1.json",
  "title": "Frozen Direction H browser instrument manifest for Direction J",
  "type": "object",
  "required": [
    "manifest_version",
    "instrument_version",
    "bridge_id",
    "status",
    "data_scope",
    "contains_real_source_text",
    "expected_items",
    "rating_representation",
    "queue",
    "activation",
    "timing_rule",
    "instrument_bundle",
    "file_locks",
    "response_layout"
  ],
  "properties": {
    "manifest_version": {"const": "direction-h-direction-j-browser-manifest-v1"},
    "instrument_version": {"const": "direction-h-direction-j-browser-v1"},
    "bridge_id": {"const": "direction-h-direction-j-synthetic-qualification-v1"},
    "status": {"const": "prepared_not_activated_or_run"},
    "data_scope": {"const": "synthetic_qualification_only"},
    "contains_real_source_text": {"const": false},
    "expected_items": {"const": 24},
    "rating_representation": {"const": "unwrapped_exact_direction-j-shared-rating-v1"},
    "queue": {
      "type": "object",
      "required": ["selected", "retired", "same_reviewer_may_run_both"],
      "properties": {
        "selected": {"const": "direction_j_exact_charlie_rep1_browser_v1"},
        "retired": {"const": "direction_h_internal_four_item_workflow_qualification"},
        "same_reviewer_may_run_both": {"const": false}
      },
      "additionalProperties": false
    },
    "activation": {
      "type": "object",
      "required": ["required", "reviewer_self_activation_allowed", "coordinator_must_not_be_charlie", "record_path"],
      "properties": {
        "required": {"const": true},
        "reviewer_self_activation_allowed": {"const": false},
        "coordinator_must_not_be_charlie": {"const": true},
        "record_path": {"const": "experiments/direction_h_human_in_loop/companion_j_bridge/browser/activation_record.json"}
      },
      "additionalProperties": false
    },
    "timing_rule": {
      "type": "object",
      "required": ["start", "stop", "page_hidden_intervals_counted", "visible_idle_grace_seconds", "visible_idle_after_grace_counted", "resume", "review_seconds_field", "retained_durations"],
      "properties": {
        "start": {"const": "complete_guide_and_item_rendered"},
        "stop": {"const": "rating_submit_before_feedback"},
        "page_hidden_intervals_counted": {"const": false},
        "visible_idle_grace_seconds": {"const": 120},
        "visible_idle_after_grace_counted": {"const": false},
        "resume": {"const": "next_keyboard_pointer_or_scroll_event"},
        "review_seconds_field": {"const": "active_duration"},
        "retained_durations": {"const": ["wall", "hidden", "idle_paused", "active"]}
      },
      "additionalProperties": false
    },
    "instrument_bundle": {
      "type": "object",
      "required": ["hash_rule", "files", "sha256"],
      "properties": {
        "hash_rule": {"const": "canonical_path_to_sha256_map_v1"},
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "file_locks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/fileLock"}
    },
    "response_layout": {
      "type": "object",
      "required": ["root", "rating_lock_directory", "rating_file", "timing_receipt_file", "feedback_commit_directory", "feedback_file", "rating_lock_commit", "feedback_commit", "overwrite_allowed"],
      "properties": {
        "root": {"const": "experiments/direction_h_human_in_loop/companion_j_bridge/browser/responses"},
        "rating_lock_directory": {"const": "locked/{sequence}_{item_id}"},
        "rating_file": {"const": "rating.json"},
        "timing_receipt_file": {"const": "timing_receipt.json"},
        "feedback_commit_directory": {"const": "feedback_commit"},
        "feedback_file": {"const": "feedback.json"},
        "rating_lock_commit": {"const": "atomic_directory_rename"},
        "feedback_commit": {"const": "atomic_directory_rename"},
        "overwrite_allowed": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fileLock": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
