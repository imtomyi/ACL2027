{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-repair-assessment-lock-v1.json",
  "title": "Direction H coordinator repair-assessment lock",
  "description": "Fail-closed proof that every planned isolated-bundle assignment has exactly one complete, validated repair-assessment/shared-rating/link triple before arm-map unblinding.",
  "type": "object",
  "required": [
    "repair_assessment_lock_version",
    "study_id",
    "schedule_id",
    "status",
    "visibility",
    "data_scope",
    "contains_protected_text",
    "locked_at_utc",
    "assignment_schedule_sha256",
    "lock_builder_script_sha256",
    "repair_assessment_lock_schema_sha256",
    "hash_serialization",
    "frozen_instrument_hashes",
    "planned_response_bundle_count",
    "locked_response_bundle_count",
    "unexpected_response_entry_count",
    "unblinding_ready",
    "records"
  ],
  "properties": {
    "repair_assessment_lock_version": {
      "const": "direction-h-repair-assessment-lock-v1"
    },
    "study_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "schedule_id": {"type": "string", "pattern": "^RASCH-[0-9A-F]{20}$"},
    "status": {"const": "locked"},
    "visibility": {"const": "coordinator_only"},
    "data_scope": {"const": "synthetic_only"},
    "contains_protected_text": {"const": false},
    "locked_at_utc": {"type": "string", "format": "date-time"},
    "assignment_schedule_sha256": {"$ref": "#/$defs/sha256"},
    "lock_builder_script_sha256": {"$ref": "#/$defs/sha256"},
    "repair_assessment_lock_schema_sha256": {"$ref": "#/$defs/sha256"},
    "hash_serialization": {"const": "utf8_json_sorted_keys_compact_plus_lf_v1"},
    "frozen_instrument_hashes": {"$ref": "#/$defs/instrumentHashes"},
    "planned_response_bundle_count": {"type": "integer", "minimum": 1},
    "locked_response_bundle_count": {"type": "integer", "minimum": 1},
    "unexpected_response_entry_count": {"const": 0},
    "unblinding_ready": {"const": true},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/lockedRecord"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instrumentHashes": {
      "type": "object",
      "required": [
        "repair_assessment_collector_script_sha256",
        "repair_panel_item_schema_sha256",
        "repair_assessor_bundle_schema_sha256",
        "pilot_item_schema_sha256",
        "qualitative_output_schema_sha256",
        "repair_assessment_schema_sha256",
        "paper_metric_rating_schema_sha256",
        "post_revision_rating_link_schema_sha256",
        "repair_assessor_runtime_readme_sha256"
      ],
      "properties": {
        "repair_assessment_collector_script_sha256": {"$ref": "#/$defs/sha256"},
        "repair_panel_item_schema_sha256": {"$ref": "#/$defs/sha256"},
        "repair_assessor_bundle_schema_sha256": {"$ref": "#/$defs/sha256"},
        "pilot_item_schema_sha256": {"$ref": "#/$defs/sha256"},
        "qualitative_output_schema_sha256": {"$ref": "#/$defs/sha256"},
        "repair_assessment_schema_sha256": {"$ref": "#/$defs/sha256"},
        "paper_metric_rating_schema_sha256": {"$ref": "#/$defs/sha256"},
        "post_revision_rating_link_schema_sha256": {"$ref": "#/$defs/sha256"},
        "repair_assessor_runtime_readme_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "lockedRecord": {
      "type": "object",
      "required": [
        "rater_id",
        "evaluator_group",
        "bundle_id",
        "assessment_id",
        "assigned_task_id",
        "assigned_blinded_revision_id",
        "corpus_id",
        "response_bundle_directory",
        "repair_assessment_file_sha256",
        "repair_assessment_record_sha256",
        "post_revision_rating_file_sha256",
        "post_revision_rating_record_sha256",
        "rating_link_file_sha256",
        "rating_link_record_sha256"
      ],
      "properties": {
        "rater_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"},
        "evaluator_group": {
          "enum": ["researcher", "qualitative_methods_expert", "domain_expert", "dual_expertise"]
        },
        "bundle_id": {"type": "string", "pattern": "^RAB-[0-9A-F]{20}$"},
        "assessment_id": {"type": "string", "pattern": "^DHA-[0-9A-F]{20}$"},
        "assigned_task_id": {"type": "string", "pattern": "^RAT-[0-9A-F]{20}$"},
        "assigned_blinded_revision_id": {"type": "string", "pattern": "^RAI-[0-9A-F]{20}$"},
        "corpus_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "response_bundle_directory": {
          "type": "string",
          "pattern": "^pilot/repair_assessor_bundles/RAB-[0-9A-F]{20}/responses/[a-z0-9][a-z0-9._-]{0,159}/DHA-[0-9A-F]{20}$"
        },
        "repair_assessment_file_sha256": {"$ref": "#/$defs/sha256"},
        "repair_assessment_record_sha256": {"$ref": "#/$defs/sha256"},
        "post_revision_rating_file_sha256": {"$ref": "#/$defs/sha256"},
        "post_revision_rating_record_sha256": {"$ref": "#/$defs/sha256"},
        "rating_link_file_sha256": {"$ref": "#/$defs/sha256"},
        "rating_link_record_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
