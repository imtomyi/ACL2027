{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-repair-assessor-roster-v1.json",
  "title": "Direction H independent repair-assessor roster",
  "description": "Coordinator-only eligibility roster and item-level replication targets. This file names reviewers but contains no panel assignment or feedback arm.",
  "type": "object",
  "required": [
    "roster_version",
    "study_id",
    "data_scope",
    "contains_real_source_text",
    "prepared_by_id",
    "prepared_at_utc",
    "assignment_targets",
    "reviewers"
  ],
  "properties": {
    "roster_version": {
      "const": "direction-h-repair-assessor-roster-v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "data_scope": {
      "const": "synthetic_only"
    },
    "contains_real_source_text": {
      "const": false
    },
    "prepared_by_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "prepared_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "assignment_targets": {
      "description": "Exact independent-review replication required for every assessable panel item, stratified by the canonical evaluator group.",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/assignmentTarget"
      }
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/reviewer"
      }
    }
  },
  "$defs": {
    "evaluatorGroup": {
      "enum": [
        "researcher",
        "qualitative_methods_expert",
        "domain_expert",
        "dual_expertise"
      ]
    },
    "assignmentTarget": {
      "type": "object",
      "required": [
        "evaluator_group",
        "assessments_per_panel_item"
      ],
      "properties": {
        "evaluator_group": {
          "$ref": "#/$defs/evaluatorGroup"
        },
        "assessments_per_panel_item": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "reviewer": {
      "type": "object",
      "required": [
        "rater_id",
        "evaluator_group",
        "is_charlie",
        "helped_develop_study",
        "independent_of_revision_and_feedback_generation",
        "blinded_to_feedback_arm",
        "eligible_for_independent_repair_panel"
      ],
      "properties": {
        "rater_id": {
          "description": "Stable lowercase pseudonym; do not place a direct personal identifier here.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,159}$"
        },
        "evaluator_group": {
          "$ref": "#/$defs/evaluatorGroup"
        },
        "is_charlie": {
          "const": false
        },
        "helped_develop_study": {
          "const": false
        },
        "independent_of_revision_and_feedback_generation": {
          "const": true
        },
        "blinded_to_feedback_arm": {
          "const": true
        },
        "eligible_for_independent_repair_panel": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
