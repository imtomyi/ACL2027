{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-repair-assessor-bundle-v1.json",
  "title": "Direction H isolated repair-assessor bundle manifest",
  "description": "Reviewer-visible authorization and item manifest for exactly one independent assessor. It contains neither the assessor's stable pseudonym nor feedback-arm, twin-list, model, or condition fields.",
  "type": "object",
  "required": [
    "bundle_manifest_version",
    "study_id",
    "schedule_id",
    "bundle_id",
    "assessor_alias",
    "evaluator_group",
    "data_scope",
    "contains_real_source_text",
    "created_at_utc",
    "parent_panel_manifest_sha256",
    "frozen_instrument_hashes",
    "assignment_payload_sha256",
    "assignment_token_hash_method",
    "assignment_token_sha256",
    "rater_binding_hash_method",
    "rater_binding_sha256",
    "item_count",
    "items"
  ],
  "properties": {
    "bundle_manifest_version": {
      "const": "direction-h-repair-assessor-bundle-v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "schedule_id": {
      "type": "string",
      "pattern": "^RASCH-[0-9A-F]{20}$"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^RAB-[0-9A-F]{20}$"
    },
    "assessor_alias": {
      "type": "string",
      "pattern": "^RAA-[0-9A-F]{20}$"
    },
    "evaluator_group": {
      "enum": [
        "researcher",
        "qualitative_methods_expert",
        "domain_expert",
        "dual_expertise"
      ]
    },
    "data_scope": {
      "const": "synthetic_only"
    },
    "contains_real_source_text": {
      "const": false
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "parent_panel_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "frozen_instrument_hashes": {
      "description": "Exact collection instrument pinned before any assessment. The collector must compare every value to the current local file before display or write.",
      "$ref": "#/$defs/instrumentHashes"
    },
    "assignment_payload_sha256": {
      "description": "SHA-256 of the canonical JSON assignment payload defined in the workflow and collector-validation contract.",
      "$ref": "#/$defs/sha256"
    },
    "assignment_token_hash_method": {
      "const": "sha256_utf8_nul_direction_h_assignment_token_v1"
    },
    "assignment_token_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "rater_binding_hash_method": {
      "const": "sha256_utf8_nul_direction_h_rater_binding_v1"
    },
    "rater_binding_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "item_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instrumentHashes": {
      "type": "object",
      "required": [
        "repair_assessment_collector_script_sha256",
        "repair_panel_item_schema_sha256",
        "repair_assessor_bundle_schema_sha256",
        "pilot_item_schema_sha256",
        "qualitative_output_schema_sha256",
        "repair_assessment_schema_sha256",
        "paper_metric_rating_schema_sha256",
        "post_revision_rating_link_schema_sha256",
        "repair_assessor_runtime_readme_sha256"
      ],
      "properties": {
        "repair_assessment_collector_script_sha256": {"$ref": "#/$defs/sha256"},
        "repair_panel_item_schema_sha256": {"$ref": "#/$defs/sha256"},
        "repair_assessor_bundle_schema_sha256": {"$ref": "#/$defs/sha256"},
        "pilot_item_schema_sha256": {"$ref": "#/$defs/sha256"},
        "qualitative_output_schema_sha256": {"$ref": "#/$defs/sha256"},
        "repair_assessment_schema_sha256": {"$ref": "#/$defs/sha256"},
        "paper_metric_rating_schema_sha256": {"$ref": "#/$defs/sha256"},
        "post_revision_rating_link_schema_sha256": {"$ref": "#/$defs/sha256"},
        "repair_assessor_runtime_readme_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "display_order",
        "blinded_revision_id",
        "task_id",
        "corpus_id",
        "packet_id",
        "starting_output_id",
        "evaluation_role",
        "target_assessment_reference_id",
        "data_classification",
        "repair_panel_item_version",
        "item_file",
        "sha256"
      ],
      "properties": {
        "display_order": {
          "type": "integer",
          "minimum": 1
        },
        "blinded_revision_id": {
          "description": "Stable opaque alias for the underlying panel revision. The same underlying revision uses the same alias in every isolated assessor bundle.",
          "type": "string",
          "pattern": "^RAI-[0-9A-F]{20}$"
        },
        "task_id": {
          "description": "Stable opaque alias for the underlying task. It makes the one-variant-per-task check possible without exposing the source task identifier.",
          "type": "string",
          "pattern": "^RAT-[0-9A-F]{20}$"
        },
        "corpus_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "packet_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "starting_output_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "evaluation_role": {
          "enum": [
            "development",
            "in_domain_audit",
            "cross_domain_confirmatory"
          ]
        },
        "target_assessment_reference_id": {
          "description": "Stable opaque alias for the underlying target-assessment reference.",
          "type": "string",
          "pattern": "^RAREF-[0-9A-F]{20}$"
        },
        "data_classification": {
          "const": "synthetic_cc0"
        },
        "repair_panel_item_version": {
          "const": "direction-h-repair-panel-item-v1"
        },
        "item_file": {
          "type": "string",
          "pattern": "^items/RAI-[0-9A-F]{20}\\.json$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
