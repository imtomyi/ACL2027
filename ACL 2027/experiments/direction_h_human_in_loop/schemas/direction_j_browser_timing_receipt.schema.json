{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-direction-j-browser-timing-receipt-v1.json",
  "title": "Direction J eligible browser timing and rating-lock receipt",
  "description": "Immutable reviewer-safe receipt created with an exact shared rating. It retains the Direction J visibility and visible-idle timing components needed for a later coordinator-only paired-observation join.",
  "type": "object",
  "required": [
    "receipt_version",
    "instrument_version",
    "bridge_id",
    "study_id",
    "run_id",
    "assignment_id",
    "sequence",
    "item_id",
    "packet_id",
    "output_id",
    "corpus_id",
    "evaluation_role",
    "actor_id",
    "actor_kind",
    "rating_repetition",
    "direction_h_case",
    "item_payload_sha256",
    "interface_version",
    "shared_rater_guide_version",
    "shared_rater_guide_sha256",
    "semantic_input_sha256",
    "prompt_or_instrument_version",
    "prompt_or_instrument_sha256",
    "browser_manifest_sha256",
    "activation_record_sha256",
    "started_at_utc",
    "rating_submitted_at_utc",
    "server_received_at_utc",
    "review_seconds",
    "timing_log",
    "rating_record_sha256",
    "blinding",
    "paired_observation_projection"
  ],
  "properties": {
    "receipt_version": {"const": "direction-h-direction-j-browser-timing-receipt-v1"},
    "instrument_version": {"const": "direction-h-direction-j-browser-v1"},
    "bridge_id": {"const": "direction-h-direction-j-synthetic-qualification-v1"},
    "study_id": {"const": "direction-j-v1"},
    "run_id": {"const": "20260825_synthetic_paired_qualification_prepared"},
    "assignment_id": {"type": "string", "pattern": "^DJA_[a-f0-9]{16}$"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 24},
    "item_id": {"type": "string", "pattern": "^DJI_[a-f0-9]{16}$"},
    "packet_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "output_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "corpus_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "evaluation_role": {"const": "synthetic_qualification"},
    "actor_id": {"const": "charlie"},
    "actor_kind": {"const": "human"},
    "rating_repetition": {"const": 1},
    "direction_h_case": {
      "type": "object",
      "required": [
        "case_id",
        "evaluator_group",
        "case_role",
        "construction_involved",
        "independent_human_pool_eligible",
        "universal_ground_truth"
      ],
      "properties": {
        "case_id": {"const": "charlie_dev_researcher_01"},
        "evaluator_group": {"const": "researcher"},
        "case_role": {"const": "developer_researcher_case_baseline"},
        "construction_involved": {"const": true},
        "independent_human_pool_eligible": {"const": false},
        "universal_ground_truth": {"const": false}
      },
      "additionalProperties": false
    },
    "item_payload_sha256": {"$ref": "#/$defs/sha256"},
    "interface_version": {"const": "direction-j-shared-interface-v1"},
    "shared_rater_guide_version": {"const": "direction-j-rater-guide-v1"},
    "shared_rater_guide_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_input_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_or_instrument_version": {"const": "direction-h-direction-j-browser-v1"},
    "prompt_or_instrument_sha256": {"$ref": "#/$defs/sha256"},
    "browser_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "activation_record_sha256": {"$ref": "#/$defs/sha256"},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "rating_submitted_at_utc": {"type": "string", "format": "date-time"},
    "server_received_at_utc": {"type": "string", "format": "date-time"},
    "review_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Direction J active duration: wall minus hidden and visible-idle-paused intervals."
    },
    "timing_log": {
      "type": "object",
      "required": [
        "rule_version",
        "clock",
        "start_event",
        "stop_event",
        "hidden_intervals_counted",
        "visible_idle_grace_ms",
        "visible_idle_after_grace_counted",
        "resume_event",
        "wall_ms",
        "hidden_ms",
        "idle_paused_ms",
        "active_ms",
        "duration_sum_error_ms",
        "activity_event_counts",
        "segments"
      ],
      "properties": {
        "rule_version": {"const": "direction-j-human-review-timing-v1"},
        "clock": {"const": "browser_performance_monotonic"},
        "start_event": {"const": "second_animation_frame_after_complete_guide_and_item_dom_render"},
        "stop_event": {"const": "rating_form_submit_received_by_browser_instrument_before_feedback"},
        "hidden_intervals_counted": {"const": false},
        "visible_idle_grace_ms": {"const": 120000},
        "visible_idle_after_grace_counted": {"const": false},
        "resume_event": {"const": "next_visible_keyboard_pointer_or_scroll_event"},
        "wall_ms": {"type": "integer", "minimum": 0},
        "hidden_ms": {"type": "integer", "minimum": 0},
        "idle_paused_ms": {"type": "integer", "minimum": 0},
        "active_ms": {"type": "integer", "minimum": 0},
        "duration_sum_error_ms": {"type": "integer", "minimum": -3, "maximum": 3},
        "activity_event_counts": {
          "type": "object",
          "required": ["keyboard", "pointer", "scroll", "resume_from_idle"],
          "properties": {
            "keyboard": {"type": "integer", "minimum": 0},
            "pointer": {"type": "integer", "minimum": 0},
            "scroll": {"type": "integer", "minimum": 0},
            "resume_from_idle": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "object",
            "required": ["index", "state", "start_offset_ms", "end_offset_ms", "duration_ms", "end_reason"],
            "properties": {
              "index": {"type": "integer", "minimum": 1},
              "state": {"enum": ["active", "hidden", "idle_paused"]},
              "start_offset_ms": {"type": "integer", "minimum": 0},
              "end_offset_ms": {"type": "integer", "minimum": 0},
              "duration_ms": {"type": "integer", "minimum": 0},
              "end_reason": {
                "enum": ["page_hidden", "page_visible", "idle_grace_elapsed", "activity_resumed", "rating_submitted"]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "rating_record_sha256": {"$ref": "#/$defs/sha256"},
    "blinding": {
      "type": "object",
      "required": [
        "candidate_identity_hidden",
        "condition_hidden",
        "other_ratings_hidden",
        "workspace_classification",
        "private_map_access_separated",
        "unblinded_at_utc"
      ],
      "properties": {
        "candidate_identity_hidden": {"const": true},
        "condition_hidden": {"const": true},
        "other_ratings_hidden": {"const": true},
        "workspace_classification": {"const": "condition_masked_developer"},
        "private_map_access_separated": {"const": false},
        "unblinded_at_utc": {"type": "null"}
      },
      "additionalProperties": false
    },
    "paired_observation_projection": {
      "type": "object",
      "required": [
        "status",
        "started_at_utc_source",
        "completed_at_utc_source",
        "review_seconds_source",
        "missing_coordinator_private_fields"
      ],
      "properties": {
        "status": {"const": "public_fields_ready_pending_locked_private_join"},
        "started_at_utc_source": {"const": "started_at_utc"},
        "completed_at_utc_source": {"const": "rating_submitted_at_utc"},
        "review_seconds_source": {"const": "review_seconds"},
        "missing_coordinator_private_fields": {
          "const": ["candidate_generation_run_id", "candidate_generation_repetition", "blind_id"]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
