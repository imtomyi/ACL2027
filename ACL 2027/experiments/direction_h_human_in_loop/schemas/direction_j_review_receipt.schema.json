{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-direction-j-review-receipt-v1.json",
  "title": "Direction H receipt for a Charlie rating of one Direction J item",
  "description": "Human role, timing, assignment, blinding, and artifact hashes kept outside the actor-neutral Direction J shared rating. This receipt is not a substitute for a direction-j-paired-observation-v1 record, which requires a later coordinator-only private join.",
  "type": "object",
  "required": [
    "receipt_version",
    "bridge_id",
    "study_id",
    "run_id",
    "assignment_id",
    "sequence",
    "item_id",
    "packet_id",
    "output_id",
    "corpus_id",
    "evaluation_role",
    "actor_id",
    "actor_kind",
    "rating_repetition",
    "direction_h_case",
    "item_payload_sha256",
    "interface_version",
    "shared_rater_guide_version",
    "shared_rater_guide_sha256",
    "semantic_input_sha256",
    "prompt_or_instrument_version",
    "prompt_or_instrument_sha256",
    "started_at_utc",
    "rating_completed_at_utc",
    "feedback_completed_at_utc",
    "rating_wall_seconds",
    "feedback_wall_seconds",
    "timing_method",
    "rating_record_sha256",
    "feedback_record_sha256",
    "blinding",
    "paired_observation_status"
  ],
  "properties": {
    "receipt_version": {
      "const": "direction-h-direction-j-review-receipt-v1"
    },
    "bridge_id": {
      "const": "direction-h-direction-j-synthetic-qualification-v1"
    },
    "study_id": {
      "const": "direction-j-v1"
    },
    "run_id": {
      "const": "20260825_synthetic_paired_qualification_prepared"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^DJA_[a-f0-9]{16}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "item_id": {
      "type": "string",
      "pattern": "^DJI_[a-f0-9]{16}$"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "output_id": {
      "type": "string",
      "minLength": 1
    },
    "corpus_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_role": {
      "const": "synthetic_qualification"
    },
    "actor_id": {
      "const": "charlie"
    },
    "actor_kind": {
      "const": "human"
    },
    "rating_repetition": {
      "const": 1
    },
    "direction_h_case": {
      "type": "object",
      "required": [
        "case_id",
        "evaluator_group",
        "case_role",
        "construction_involved",
        "independent_human_pool_eligible",
        "universal_ground_truth"
      ],
      "properties": {
        "case_id": {
          "const": "charlie_dev_researcher_01"
        },
        "evaluator_group": {
          "const": "researcher"
        },
        "case_role": {
          "const": "developer_researcher_case_baseline"
        },
        "construction_involved": {
          "const": true
        },
        "independent_human_pool_eligible": {
          "const": false
        },
        "universal_ground_truth": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "item_payload_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "interface_version": {
      "const": "direction-j-shared-interface-v1"
    },
    "shared_rater_guide_version": {
      "const": "direction-j-rater-guide-v1"
    },
    "shared_rater_guide_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "semantic_input_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prompt_or_instrument_version": {
      "const": "direction-h-direction-j-charlie-instrument-v1"
    },
    "prompt_or_instrument_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "rating_completed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "feedback_completed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "rating_wall_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "feedback_wall_seconds": {
      "type": "number",
      "minimum": 0
    },
    "timing_method": {
      "type": "object",
      "required": [
        "start_event",
        "rating_stop_event",
        "feedback_stop_event",
        "measurement",
        "visibility_tracking_available",
        "idle_pause_rule_available",
        "direction_j_review_seconds_eligible"
      ],
      "properties": {
        "start_event": {
          "const": "complete_shared_guide_and_item_rendered"
        },
        "rating_stop_event": {
          "const": "last_exact_rating_field_received_before_feedback"
        },
        "feedback_stop_event": {
          "const": "last_feedback_field_received"
        },
        "measurement": {
          "const": "continuous_cli_wall_elapsed"
        },
        "visibility_tracking_available": {
          "const": false
        },
        "idle_pause_rule_available": {
          "const": false
        },
        "direction_j_review_seconds_eligible": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "rating_record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "feedback_record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "blinding": {
      "type": "object",
      "required": [
        "presented_item_omits_candidate_identity",
        "presented_item_omits_condition",
        "presented_item_omits_other_ratings",
        "workspace_classification",
        "private_map_access_separated",
        "unblinded_at_utc"
      ],
      "properties": {
        "presented_item_omits_candidate_identity": {
          "const": true
        },
        "presented_item_omits_condition": {
          "const": true
        },
        "presented_item_omits_other_ratings": {
          "const": true
        },
        "workspace_classification": {
          "const": "condition_masked_developer"
        },
        "private_map_access_separated": {
          "const": false
        },
        "unblinded_at_utc": {
          "type": "null"
        }
      },
      "additionalProperties": false
    },
    "paired_observation_status": {
      "const": "pending_coordinator_private_join"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
