{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-direction-j-browser-first-stage-lock-v1.json",
  "title": "Complete Direction H browser first-stage lock for the exact Direction J Charlie queue",
  "type": "object",
  "required": [
    "lock_version",
    "instrument_version",
    "bridge_id",
    "lock_id",
    "locked_at_utc",
    "locked_by_actor_id",
    "locker_is_charlie",
    "expected_records",
    "completed_records",
    "write_window_closed",
    "ratings_mutable",
    "feedback_mutable",
    "private_map_opened",
    "unblinded_at_utc",
    "browser_manifest_sha256",
    "activation_record_sha256",
    "charlie_assignment_sha256",
    "records",
    "records_sha256"
  ],
  "properties": {
    "lock_version": {"const": "direction-h-direction-j-browser-first-stage-lock-v1"},
    "instrument_version": {"const": "direction-h-direction-j-browser-v1"},
    "bridge_id": {"const": "direction-h-direction-j-synthetic-qualification-v1"},
    "lock_id": {"type": "string", "pattern": "^DHJBL_[a-f0-9]{16}$"},
    "locked_at_utc": {"type": "string", "format": "date-time"},
    "locked_by_actor_id": {"type": "string", "minLength": 1, "maxLength": 160, "not": {"const": "charlie"}},
    "locker_is_charlie": {"const": false},
    "expected_records": {"const": 24},
    "completed_records": {"const": 24},
    "write_window_closed": {"const": true},
    "ratings_mutable": {"const": false},
    "feedback_mutable": {"const": false},
    "private_map_opened": {"const": false},
    "unblinded_at_utc": {"type": "null"},
    "browser_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "activation_record_sha256": {"$ref": "#/$defs/sha256"},
    "charlie_assignment_sha256": {"$ref": "#/$defs/sha256"},
    "records": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "assignment_id",
          "item_id",
          "packet_id",
          "output_id",
          "item_payload_sha256",
          "semantic_input_sha256",
          "rating_path",
          "rating_sha256",
          "timing_receipt_path",
          "timing_receipt_sha256",
          "feedback_path",
          "feedback_sha256"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 24},
          "assignment_id": {"type": "string", "pattern": "^DJA_[a-f0-9]{16}$"},
          "item_id": {"type": "string", "pattern": "^DJI_[a-f0-9]{16}$"},
          "packet_id": {"type": "string", "minLength": 1},
          "output_id": {"type": "string", "minLength": 1},
          "item_payload_sha256": {"$ref": "#/$defs/sha256"},
          "semantic_input_sha256": {"$ref": "#/$defs/sha256"},
          "rating_path": {"type": "string", "minLength": 1},
          "rating_sha256": {"$ref": "#/$defs/sha256"},
          "timing_receipt_path": {"type": "string", "minLength": 1},
          "timing_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "feedback_path": {"type": "string", "minLength": 1},
          "feedback_sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    },
    "records_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
