{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-synthetic-truth-v1.json",
  "title": "Direction H coordinator-only synthetic truth map",
  "description": "Committed manipulation metadata used only after ratings and feedback lock. A target flag is a designed-condition label, not universal qualitative truth.",
  "type": "object",
  "required": [
    "truth_map_version",
    "study_id",
    "created_at",
    "access",
    "label_semantics",
    "items"
  ],
  "properties": {
    "truth_map_version": {"const": "direction-h-synthetic-truth-v1"},
    "study_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "created_at": {"type": "string", "format": "date-time"},
    "access": {"const": "coordinator_only_until_ratings_and_feedback_lock"},
    "label_semantics": {"type": "string", "minLength": 1, "maxLength": 3000},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/truthItem"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "errorFlag": {
      "enum": [
        "fabricated_or_altered_quote",
        "wrong_attribution",
        "unsupported_inference",
        "hidden_source_concentration",
        "lost_negative_case",
        "contextual_flattening",
        "unsupported_abstraction",
        "sensitive_or_diagnostic_inference",
        "inconsistent_codebook",
        "other"
      ]
    },
    "plantedDefect": {
      "type": "object",
      "required": [
        "target_flag",
        "primary_construct",
        "target_location",
        "original_value_sha256",
        "transformation"
      ],
      "properties": {
        "target_flag": {"$ref": "#/$defs/errorFlag"},
        "accepted_detection_flags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/errorFlag"},
          "uniqueItems": true
        },
        "primary_construct": {
          "enum": [
            "evidential_credibility",
            "voice_boundary_preservation",
            "scope_calibration"
          ]
        },
        "severity": {"enum": ["minor", "material", "high_consequence"]},
        "target_location": {"type": "string", "minLength": 1, "maxLength": 2000},
        "original_value_sha256": {"$ref": "#/$defs/sha256"},
        "transformation": {"type": "string", "minLength": 1, "maxLength": 3000},
        "repair_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"type": "string", "minLength": 1, "maxLength": 1500},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "truthItem": {
      "type": "object",
      "required": [
        "task_id",
        "packet_id",
        "output_id",
        "source_bundle",
        "source_bundle_sha256",
        "source_blind_id",
        "source_output_sha256",
        "condition",
        "planted_defect",
        "background_error_status"
      ],
      "properties": {
        "task_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "packet_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "output_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "source_bundle": {"type": "string", "minLength": 1, "maxLength": 1000},
        "source_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "source_blind_id": {"type": "string", "pattern": "^B[1-9][0-9]*$"},
        "source_output_sha256": {"$ref": "#/$defs/sha256"},
        "condition": {"enum": ["no_planted_defect_control", "controlled_defect"]},
        "planted_defect": {
          "oneOf": [
            {"$ref": "#/$defs/plantedDefect"},
            {"type": "null"}
          ]
        },
        "background_error_status": {"type": "string", "minLength": 1, "maxLength": 3000}
      },
      "allOf": [
        {
          "if": {
            "properties": {"condition": {"const": "no_planted_defect_control"}},
            "required": ["condition"]
          },
          "then": {"properties": {"planted_defect": {"type": "null"}}},
          "else": {"properties": {"planted_defect": {"$ref": "#/$defs/plantedDefect"}}}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
