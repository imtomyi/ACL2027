{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-j-theme/model-output-v1.json",
  "title": "Truth-blind theme-level revision model response",
  "description": "The model may revise the proposed interpretation and candidate assertion layer. It cannot emit or alter displayed source text or actual provenance because those fields are absent.",
  "type": "object",
  "required": [
    "model_output_version",
    "revision_diagnosis",
    "revised_proposed_interpretation",
    "revised_candidate_assertions"
  ],
  "properties": {
    "model_output_version": {"const": "direction-h-j-theme-model-output-v1"},
    "revision_diagnosis": {
      "type": "object",
      "required": ["detected_error_flags", "findings", "summary"],
      "properties": {
        "detected_error_flags": {
          "type": "array",
          "items": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/errorFlag"},
          "uniqueItems": true
        },
        "findings": {
          "type": "array",
          "maxItems": 12,
          "items": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/diagnosticFinding"}
        },
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "additionalProperties": false
    },
    "revised_proposed_interpretation": {
      "$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/proposedInterpretation"
    },
    "revised_candidate_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/candidateAssertion"}
    }
  },
  "additionalProperties": false
}
