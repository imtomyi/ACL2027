{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json",
  "title": "Common definitions for Direction H theme-level revision of Direction J items",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fileLock": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "nullableFileLock": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "errorFlag": {
      "enum": [
        "fabricated_or_altered_quote",
        "wrong_attribution",
        "unsupported_inference",
        "hidden_source_concentration",
        "lost_negative_case",
        "contextual_flattening",
        "unsupported_abstraction",
        "sensitive_or_diagnostic_inference",
        "inconsistent_codebook",
        "other"
      ]
    },
    "proposedInterpretation": {
      "type": "object",
      "required": ["theme_id", "theme_name", "claim", "explanation", "boundary_conditions"],
      "properties": {
        "theme_id": {"type": "string", "minLength": 1},
        "theme_name": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1},
        "boundary_conditions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "candidateAssertion": {
      "type": "object",
      "description": "The editable candidate-assertion layer for one immutable displayed evidence row. Actual excerpt text and provenance are intentionally absent.",
      "required": [
        "display_order",
        "excerpt_id",
        "candidate_attributed_excerpt_id",
        "candidate_attributed_source_id",
        "candidate_attributed_speaker_id",
        "candidate_quote",
        "candidate_role",
        "candidate_warrant"
      ],
      "properties": {
        "display_order": {"type": "integer", "minimum": 1},
        "excerpt_id": {"type": "string", "minLength": 1},
        "candidate_attributed_excerpt_id": {"type": ["string", "null"], "minLength": 1},
        "candidate_attributed_source_id": {"type": ["string", "null"], "minLength": 1},
        "candidate_attributed_speaker_id": {"type": ["string", "null"], "minLength": 1},
        "candidate_quote": {"type": ["string", "null"], "minLength": 1},
        "candidate_role": {"enum": ["support", "counterevidence", "context_only"]},
        "candidate_warrant": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"candidate_role": {"const": "context_only"}},
            "required": ["candidate_role"]
          },
          "then": {
            "properties": {
              "candidate_attributed_excerpt_id": {"type": "null"},
              "candidate_attributed_source_id": {"type": "null"},
              "candidate_attributed_speaker_id": {"type": "null"},
              "candidate_quote": {"type": "null"},
              "candidate_warrant": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "candidate_attributed_excerpt_id": {"type": "string"},
              "candidate_attributed_source_id": {"type": "string"},
              "candidate_quote": {"type": "string"},
              "candidate_warrant": {"type": "string"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "diagnosticFinding": {
      "type": "object",
      "required": ["error_flag", "item_locations", "evidence_excerpt_ids", "description"],
      "properties": {
        "error_flag": {"$ref": "#/$defs/errorFlag"},
        "item_locations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"type": "string", "pattern": "^/", "maxLength": 500},
          "uniqueItems": true
        },
        "evidence_excerpt_ids": {
          "type": "array",
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "description": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "additionalProperties": false
    }
  }
}
