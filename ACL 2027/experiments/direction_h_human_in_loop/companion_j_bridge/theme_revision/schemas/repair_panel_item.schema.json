{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-j-theme/repair-panel-item-v1.json",
  "title": "Arm-blind repair panel item for one completed theme revision",
  "type": "object",
  "required": [
    "panel_item_version", "repair_packet_id", "item_id", "revision_id",
    "original_evaluator_item", "revised_evaluator_item", "target_assessment_brief",
    "assessment_schema_version", "assessment_schema_sha256"
  ],
  "properties": {
    "panel_item_version": {"const": "direction-h-j-theme-repair-panel-item-v1"},
    "repair_packet_id": {"type": "string", "pattern": "^DHJRP_[a-f0-9]{20}$"},
    "item_id": {"type": "string", "pattern": "^DJI_[a-f0-9]{16}$"},
    "revision_id": {"type": "string", "pattern": "^DHJRV_[a-f0-9]{20}$"},
    "original_evaluator_item": {"$ref": "https://warrantroute.local/schemas/direction-j/evaluator-item-v1.json"},
    "revised_evaluator_item": {"$ref": "https://warrantroute.local/schemas/direction-j/evaluator-item-v1.json"},
    "target_assessment_brief": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/target-briefs-v1.json#/$defs/brief"},
    "assessment_schema_version": {"const": "direction-j-repair-assessment-v1"},
    "assessment_schema_sha256": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/sha256"}
  },
  "additionalProperties": false
}
