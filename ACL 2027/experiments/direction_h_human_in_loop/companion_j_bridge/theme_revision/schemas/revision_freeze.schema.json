{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/direction-h-j-theme/revision-freeze-v1.json",
  "title": "Prospective freeze for paired theme-level revision",
  "type": "object",
  "required": [
    "freeze_version", "freeze_id", "status", "frozen_at_utc", "scope",
    "upstream_direction_j", "browser_first_stage", "target_gate", "revision_model",
    "revision_prompt", "feedback_formatter", "schemas", "software",
    "decoding", "retry_policy", "repeat_policy", "arm_policy", "blinding",
    "control_policy", "outcome_policy", "change_control"
  ],
  "properties": {
    "freeze_version": {"const": "direction-h-j-theme-revision-freeze-v1"},
    "freeze_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 160},
    "status": {"enum": ["draft_template", "frozen", "superseded"]},
    "frozen_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "scope": {"const": "synthetic_qualification_theme_level"},
    "upstream_direction_j": {
      "type": "object",
      "required": ["evaluator_items", "charlie_assignment", "shared_rating_schema", "repair_assessment_schema"],
      "properties": {
        "evaluator_items": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"},
        "charlie_assignment": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"},
        "shared_rating_schema": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"},
        "repair_assessment_schema": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"}
      },
      "additionalProperties": false
    },
    "browser_first_stage": {
      "type": "object",
      "required": ["manifest", "activation_record", "first_stage_lock", "rating_schema", "timing_schema", "feedback_schema"],
      "properties": {
        "manifest": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/nullableFileLock"},
        "activation_record": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/nullableFileLock"},
        "first_stage_lock": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/nullableFileLock"},
        "rating_schema": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"},
        "timing_schema": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/nullableFileLock"},
        "feedback_schema": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/nullableFileLock"}
      },
      "additionalProperties": false
    },
    "target_gate": {
      "type": "object",
      "required": ["verification", "target_briefs", "target_brief_commitment"],
      "properties": {
        "verification": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/nullableFileLock"},
        "target_briefs": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/nullableFileLock"},
        "target_brief_commitment": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/nullableFileLock"}
      },
      "additionalProperties": false
    },
    "revision_model": {
      "type": "object",
      "required": ["provider", "model_id", "snapshot_id", "runtime_surface"],
      "properties": {
        "provider": {"type": ["string", "null"], "minLength": 1},
        "model_id": {"type": ["string", "null"], "minLength": 1},
        "snapshot_id": {"type": ["string", "null"], "minLength": 1},
        "runtime_surface": {"type": ["string", "null"], "minLength": 1}
      },
      "additionalProperties": false
    },
    "revision_prompt": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"},
    "feedback_formatter": {
      "type": "object",
      "required": ["version", "fields_in_order", "serialization", "implementation"],
      "properties": {
        "version": {"const": "direction-h-j-theme-feedback-formatter-v1"},
        "fields_in_order": {
          "type": "array",
          "prefixItems": [
            {"const": "feedback_summary"}, {"const": "findings"},
            {"const": "preserve"}, {"const": "uncertainties"}
          ],
          "items": false, "minItems": 4, "maxItems": 4
        },
        "serialization": {"const": "exact_json_object_no_author_rating_confidence_or_time"},
        "implementation": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"}
      },
      "additionalProperties": false
    },
    "schemas": {
      "type": "object",
      "required": ["case", "model_output", "revision_output", "repair_panel_item"],
      "properties": {
        "case": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"},
        "model_output": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"},
        "revision_output": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"},
        "repair_panel_item": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"}
      },
      "additionalProperties": false
    },
    "software": {
      "type": "object",
      "required": ["validator", "case_builder", "output_recorder"],
      "properties": {
        "validator": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"},
        "case_builder": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"},
        "output_recorder": {"$ref": "https://warrantroute.local/schemas/direction-h-j-theme/common-v1.json#/$defs/fileLock"}
      },
      "additionalProperties": false
    },
    "decoding": {
      "type": "object",
      "required": ["temperature", "top_p", "seed", "reasoning_effort", "max_output_tokens", "additional_parameters"],
      "properties": {
        "temperature": {"type": ["number", "null"], "minimum": 0, "maximum": 2},
        "top_p": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "seed": {"type": ["integer", "null"]},
        "reasoning_effort": {"type": ["string", "null"]},
        "max_output_tokens": {"type": ["integer", "null"], "minimum": 1},
        "additional_parameters": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
      },
      "additionalProperties": false
    },
    "retry_policy": {
      "type": "object",
      "required": ["maximum_attempts_per_case", "automatic_retries", "format_repair", "retain_failure", "failure_primary_success_value"],
      "properties": {
        "maximum_attempts_per_case": {"const": 1},
        "automatic_retries": {"const": false},
        "format_repair": {"const": false},
        "retain_failure": {"const": true},
        "failure_primary_success_value": {"const": 0}
      },
      "additionalProperties": false
    },
    "repeat_policy": {
      "type": "object",
      "required": ["repeats_per_arm", "pair_by_repeat_index", "best_repeat_selection"],
      "properties": {
        "repeats_per_arm": {"const": 1},
        "pair_by_repeat_index": {"const": true},
        "best_repeat_selection": {"const": false}
      },
      "additionalProperties": false
    },
    "arm_policy": {
      "type": "object",
      "required": ["arms", "paired_within_item", "eligible_targets", "include_charlie_misses", "only_model_visible_difference", "fresh_context_per_case"],
      "properties": {
        "arms": {"type": "array", "prefixItems": [{"const": "no_feedback"}, {"const": "charlie_feedback"}], "items": false, "minItems": 2, "maxItems": 2},
        "paired_within_item": {"const": true},
        "eligible_targets": {"const": "every_independently_verified_defective_item_with_complete_valid_locked_feedback"},
        "include_charlie_misses": {"const": true},
        "only_model_visible_difference": {"const": "reviewer_feedback_literal_null_vs_exact_locked_identity_free_model_feedback"},
        "fresh_context_per_case": {"const": true}
      },
      "additionalProperties": false
    },
    "blinding": {
      "type": "object",
      "required": ["model_receives_target", "model_receives_condition", "model_receives_feedback_author", "model_receives_arm", "panel_receives_arm", "panel_receives_feedback", "panel_receives_model_identity"],
      "properties": {
        "model_receives_target": {"const": false},
        "model_receives_condition": {"const": false},
        "model_receives_feedback_author": {"const": false},
        "model_receives_arm": {"const": false},
        "panel_receives_arm": {"const": false},
        "panel_receives_feedback": {"const": false},
        "panel_receives_model_identity": {"const": false}
      },
      "additionalProperties": false
    },
    "control_policy": {
      "type": "object",
      "required": ["controls_enter_primary_repair", "retained_for_safety_analysis", "requires_separate_freeze"],
      "properties": {
        "controls_enter_primary_repair": {"const": false},
        "retained_for_safety_analysis": {"const": true},
        "requires_separate_freeze": {"const": true}
      },
      "additionalProperties": false
    },
    "outcome_policy": {
      "type": "object",
      "required": ["assessment_version", "primary_success", "cannot_judge_handling", "failure_handling"],
      "properties": {
        "assessment_version": {"const": "direction-j-repair-assessment-v1"},
        "primary_success": {"const": "targeted_defect_repaired_true_and_accurate_material_preserved_true_and_zero_collateral_error_flags"},
        "cannot_judge_handling": {"const": "assessment_endpoint_null_sensitivity_only_pipeline_success_not_established"},
        "failure_handling": {"const": "all_allocated_model_or_pipeline_failures_remain_itt_with_S_0"}
      },
      "additionalProperties": false
    },
    "change_control": {
      "type": "object",
      "required": ["new_version_for_any_change", "never_change_after_output_inspection"],
      "properties": {
        "new_version_for_any_change": {"const": true},
        "never_change_after_output_inspection": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "frozen"}}, "required": ["status"]},
      "then": {
        "properties": {
          "freeze_id": {"type": "string"},
          "frozen_at_utc": {"type": "string"},
          "revision_model": {"properties": {"provider": {"type": "string"}, "model_id": {"type": "string"}, "snapshot_id": {"type": "string"}, "runtime_surface": {"type": "string"}}},
          "decoding": {"properties": {"max_output_tokens": {"type": "integer"}}}
        }
      },
      "else": {
        "properties": {
          "freeze_id": {"type": "null"},
          "frozen_at_utc": {"type": "null"}
        }
      }
    }
  ],
  "additionalProperties": false
}
