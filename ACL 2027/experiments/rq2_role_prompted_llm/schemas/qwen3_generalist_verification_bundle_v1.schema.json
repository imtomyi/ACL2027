{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/qwen3-generalist-verification-bundle-v1.json",
  "title": "Independent controlled-error verification bundle",
  "type": "object",
  "required": [
    "document_type",
    "bundle_version",
    "study_id",
    "contains_source_text",
    "corpus_id",
    "official_source_split",
    "candidate_generator_actor_id",
    "reviewer_actor_id",
    "items"
  ],
  "properties": {
    "document_type": {
      "const": "warrantroute_qwen3_generalist_verification_bundle"
    },
    "bundle_version": {
      "const": "qwen3-generalist-verification-bundle-v1"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "contains_source_text": {
      "const": false
    },
    "corpus_id": {
      "const": "dreaddit"
    },
    "official_source_split": {
      "const": "test"
    },
    "candidate_generator_actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "reviewer_actor_id": {
      "const": "qwen3_8b_generalist_reviewer_v1"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/verificationItem"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "errorFamily": {
      "enum": [
        "unsupported_evidence",
        "source_concentration",
        "counterevidence_loss",
        "contextual_flattening",
        "unsupported_abstraction"
      ]
    },
    "requiredFlag": {
      "enum": [
        "unsupported_inference",
        "hidden_source_concentration",
        "lost_negative_case",
        "contextual_flattening",
        "unsupported_abstraction"
      ]
    },
    "verificationRecord": {
      "type": "object",
      "required": [
        "verifier_actor_id",
        "verifier_kind",
        "reviewed_at_utc",
        "decision",
        "evaluator_item_sha256",
        "error_family",
        "required_flag",
        "independent_of_candidate_generator",
        "independent_of_reviewer",
        "verification_payload_sha256"
      ],
      "properties": {
        "verifier_actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "verifier_kind": {
          "enum": [
            "human",
            "llm"
          ]
        },
        "reviewed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "const": "verified_single_target_error_no_second_manipulation"
        },
        "evaluator_item_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "error_family": {
          "$ref": "#/$defs/errorFamily"
        },
        "required_flag": {
          "$ref": "#/$defs/requiredFlag"
        },
        "independent_of_candidate_generator": {
          "const": true
        },
        "independent_of_reviewer": {
          "const": true
        },
        "verification_payload_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "verificationItem": {
      "type": "object",
      "required": [
        "item_id",
        "evaluator_item_sha256",
        "error_family",
        "required_flag",
        "verifications"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^DJI_[a-f0-9]{16}$"
        },
        "evaluator_item_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "error_family": {
          "$ref": "#/$defs/errorFamily"
        },
        "required_flag": {
          "$ref": "#/$defs/requiredFlag"
        },
        "verifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/verificationRecord"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
