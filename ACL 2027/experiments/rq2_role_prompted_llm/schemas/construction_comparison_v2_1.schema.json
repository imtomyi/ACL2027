{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/construction-comparison-v2.1.json",
  "title": "Ollama-compatible target-blind construction comparison",
  "type": "object",
  "required": [
    "comparison_schema_version",
    "comparison_clarity",
    "present_flaws",
    "other_material_flaw",
    "single_material_difference",
    "anchors",
    "uncertainty_codes"
  ],
  "properties": {
    "comparison_schema_version": {"enum": ["rq2-construction-comparison-v2.1"]},
    "comparison_clarity": {"enum": ["clear", "unclear"]},
    "present_flaws": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "unsupported_evidence",
          "source_concentration",
          "counterevidence_loss",
          "contextual_flattening",
          "unsupported_abstraction"
        ]
      }
    },
    "other_material_flaw": {"type": "boolean"},
    "single_material_difference": {"type": "boolean"},
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flaw_family",
          "evidence_positions",
          "interpretation_fields",
          "reason_code"
        ],
        "properties": {
          "flaw_family": {
            "enum": [
              "unsupported_evidence",
              "source_concentration",
              "counterevidence_loss",
              "contextual_flattening",
              "unsupported_abstraction"
            ]
          },
          "evidence_positions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
          },
          "interpretation_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["claim", "explanation", "boundary_conditions", "evidence_roles"]
            }
          },
          "reason_code": {
            "enum": [
              "cited_position_does_not_support_material_claim",
              "claim_generalizes_beyond_single_cited_unit",
              "consequential_countercase_qualification_omitted",
              "locally_stated_noncontradictory_distinction_collapsed",
              "claim_scope_or_strength_exceeds_displayed_evidence"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "uncertainty_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "insufficient_displayed_context",
          "diff_not_semantically_clear",
          "multiple_plausible_classifications",
          "anchor_not_identifiable",
          "base_seal_or_diff_incomplete"
        ]
      }
    }
  },
  "additionalProperties": false
}
