{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/qwen3-generalist-preaccess-record-v1.json",
  "title": "Dreaddit held-out pre-review access record",
  "type": "object",
  "required": [
    "document_type",
    "record_version",
    "status",
    "study_id",
    "contains_source_text",
    "corpus_id",
    "official_source_split",
    "study_design_freeze_sha256",
    "source_receipt_sha256",
    "packet_manifest_sha256",
    "design_frozen_at_utc",
    "first_heldout_access_at_utc",
    "packet_construction_completed_at_utc",
    "recorded_at_utc",
    "reviewer_execution_started_at_utc",
    "reviewer_outputs_observed",
    "test_outcomes_observed",
    "recorded_by_authority_id"
  ],
  "properties": {
    "document_type": {
      "const": "warrantroute_qwen3_generalist_preaccess_record"
    },
    "record_version": {
      "const": "qwen3-generalist-preaccess-record-v1"
    },
    "status": {
      "const": "sealed_clean_before_reviewer_execution"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "contains_source_text": {
      "const": false
    },
    "corpus_id": {
      "const": "dreaddit"
    },
    "official_source_split": {
      "const": "test"
    },
    "study_design_freeze_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "packet_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "design_frozen_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "first_heldout_access_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "packet_construction_completed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "reviewer_execution_started_at_utc": {
      "type": "null"
    },
    "reviewer_outputs_observed": {
      "const": false
    },
    "test_outcomes_observed": {
      "const": false
    },
    "recorded_by_authority_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
