{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/unsupported-abstraction-edit-v2.1.json",
  "title": "Ollama-compatible atomic unsupported-abstraction edit",
  "type": "object",
  "required": ["edit_schema_version", "status", "patch", "reason_codes"],
  "properties": {
    "edit_schema_version": {"enum": ["rq2-unsupported-abstraction-edit-v2.1"]},
    "status": {"enum": ["proposed", "not_constructable"]},
    "patch": {
      "type": "object",
      "required": [
        "edit_field",
        "replacement_text",
        "evidence_positions",
        "edit_intent_code"
      ],
      "properties": {
        "edit_field": {"enum": ["claim", "not_applicable"]},
        "replacement_text": {"type": "string", "minLength": 1},
        "evidence_positions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
        },
        "edit_intent_code": {
          "enum": ["broaden_claim_exactly_one_unsupported_level", "not_constructed"]
        }
      },
      "additionalProperties": false
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "bounded_claim_not_clear",
          "one_level_broadening_not_possible",
          "edit_would_introduce_second_flaw",
          "outside_fact_would_be_required"
        ]
      }
    }
  },
  "additionalProperties": false
}
