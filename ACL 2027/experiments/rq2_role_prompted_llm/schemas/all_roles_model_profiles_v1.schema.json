{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/all-roles-model-profiles-v1.json",
  "title": "WarrantRoute All roles source-free model profiles",
  "type": "object",
  "required": [
    "document_type",
    "registry_version",
    "primary_profile_id",
    "source_free_compatibility_only",
    "real_execution_authorized",
    "profiles"
  ],
  "properties": {
    "document_type": {
      "const": "warrantroute_all_roles_model_profile_registry"
    },
    "registry_version": {"const": "all-roles-model-profiles-v1"},
    "primary_profile_id": {"const": "qwen3_8b"},
    "source_free_compatibility_only": {"const": true},
    "real_execution_authorized": {"const": false},
    "profiles": {
      "type": "object",
      "required": ["qwen3_8b", "llama3_1_8b", "gemma3_4b"],
      "properties": {
        "qwen3_8b": {"$ref": "#/$defs/profile"},
        "llama3_1_8b": {"$ref": "#/$defs/profile"},
        "gemma3_4b": {"$ref": "#/$defs/profile"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "profile": {
      "type": "object",
      "required": [
        "profile_id",
        "profile_status",
        "model_family",
        "model_id",
        "local_manifest_path",
        "local_manifest_file_sha256",
        "config_digest",
        "model_layer_digest",
        "template_layer_digest",
        "license_layer_digest",
        "params_layer_digest",
        "inherited_manifest_parameters",
        "role_actor_ids",
        "transport"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]{0,63}$"
        },
        "profile_status": {
          "enum": [
            "primary_source_free_canary_passed",
            "compatibility_profile_requires_source_free_canary",
            "compatibility_source_free_canary_passed"
          ]
        },
        "model_family": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
        },
        "model_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}:[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "local_manifest_path": {
          "type": "string",
          "pattern": "^/Users/OODI/\\.ollama/models/manifests/registry\\.ollama\\.ai/library/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        },
        "local_manifest_file_sha256": {"$ref": "#/$defs/sha256"},
        "config_digest": {"$ref": "#/$defs/digest"},
        "model_layer_digest": {"$ref": "#/$defs/digest"},
        "template_layer_digest": {"$ref": "#/$defs/digest"},
        "license_layer_digest": {"$ref": "#/$defs/digest"},
        "params_layer_digest": {"$ref": "#/$defs/digest"},
        "inherited_manifest_parameters": {
          "type": "object"
        },
        "role_actor_ids": {
          "type": "object",
          "required": ["researcher", "qualitative_methods", "domain"],
          "properties": {
            "researcher": {"$ref": "#/$defs/actorId"},
            "qualitative_methods": {"$ref": "#/$defs/actorId"},
            "domain": {"$ref": "#/$defs/actorId"}
          },
          "additionalProperties": false
        },
        "transport": {
          "type": "object",
          "required": [
            "generation_format",
            "transport_schema_asset",
            "postvalidation_schema_asset",
            "message_packaging"
          ],
          "properties": {
            "generation_format": {"const": "flat_json_schema"},
            "transport_schema_asset": {
              "const": "shared_rating_transport_schema"
            },
            "postvalidation_schema_asset": {"const": "shared_rating_schema"},
            "message_packaging": {
              "enum": [
                "system_and_user_messages",
                "single_user_role_contract_then_item"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "actorId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]{0,127}$"
    }
  }
}
