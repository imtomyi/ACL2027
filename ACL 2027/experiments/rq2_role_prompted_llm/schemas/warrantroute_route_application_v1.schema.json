{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/warrantroute-route-application-v1.json",
  "title": "Source-free WarrantRoute route-application contract fixture",
  "type": "object",
  "required": [
    "application_schema_version",
    "study_id",
    "item_id",
    "evaluator_item_sha256",
    "lane",
    "route_record",
    "route_seal",
    "reviewer_model",
    "role_observations",
    "contains_source_text",
    "contains_router_training_label",
    "contains_verified_error"
  ],
  "properties": {
    "application_schema_version": {"const": "warrantroute-route-application-v1"},
    "study_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "item_id": {"type": "string", "pattern": "^DJI_[a-f0-9]{16}$"},
    "evaluator_item_sha256": {"$ref": "#/$defs/sha256"},
    "lane": {"$ref": "#/$defs/lane"},
    "route_record": {"$ref": "#/$defs/routeRecord"},
    "route_seal": {"$ref": "#/$defs/routeSeal"},
    "reviewer_model": {
      "type": "object",
      "required": ["model_id", "model_snapshot_sha256"],
      "properties": {
        "model_id": {"const": "qwen3:8b"},
        "model_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "role_observations": {
      "type": "object",
      "required": ["researcher", "qualitative_methods", "domain"],
      "properties": {
        "researcher": {"$ref": "#/$defs/observationSet"},
        "qualitative_methods": {"$ref": "#/$defs/observationSet"},
        "domain": {"$ref": "#/$defs/observationSet"}
      },
      "additionalProperties": false
    },
    "contains_source_text": {"const": false},
    "contains_router_training_label": {"const": false},
    "contains_verified_error": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "role": {"enum": ["researcher", "qualitative_methods", "domain"]},
    "flag": {
      "enum": [
        "fabricated_or_altered_quote",
        "wrong_attribution",
        "unsupported_inference",
        "hidden_source_concentration",
        "lost_negative_case",
        "contextual_flattening",
        "unsupported_abstraction",
        "sensitive_or_diagnostic_inference",
        "inconsistent_codebook",
        "other"
      ]
    },
    "lane": {
      "oneOf": [
        {
          "const": {
            "corpus": "dreaddit",
            "source_split": "official_train",
            "internal_lane": "development_train",
            "experimental_role": "development_diagnostic",
            "heldout": false
          }
        },
        {
          "const": {
            "corpus": "dreaddit",
            "source_split": "official_test",
            "internal_lane": "in_domain_audit",
            "experimental_role": "post_development_audit_diagnostic",
            "heldout": true
          }
        },
        {
          "const": {
            "corpus": "agyw_focus_groups",
            "source_split": "all_focus_groups",
            "internal_lane": "heldout_cross_domain_evaluation",
            "experimental_role": "heldout_cross_domain_diagnostic",
            "heldout": true
          }
        }
      ]
    },
    "routeRecord": {
      "type": "object",
      "required": [
        "route_record_version",
        "study_id",
        "item_id",
        "evaluator_item_sha256",
        "lane",
        "router_input_sha256",
        "policy_manifest_sha256",
        "policy_asset_sha256",
        "route",
        "selected_roles",
        "route_source",
        "policy_frozen_before_heldout_access",
        "route_changed_after_freeze",
        "contains_source_text",
        "manuscript_eligible"
      ],
      "properties": {
        "route_record_version": {"const": "warrantroute-route-record-v1"},
        "study_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "item_id": {"type": "string", "pattern": "^DJI_[a-f0-9]{16}$"},
        "evaluator_item_sha256": {"$ref": "#/$defs/sha256"},
        "lane": {"$ref": "#/$defs/lane"},
        "router_input_sha256": {"$ref": "#/$defs/sha256"},
        "policy_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "policy_asset_sha256": {"$ref": "#/$defs/sha256"},
        "route": {"enum": ["none", "qualitative_methods", "domain", "both"]},
        "selected_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/role"}
        },
        "route_source": {"const": "frozen_policy"},
        "policy_frozen_before_heldout_access": {"const": true},
        "route_changed_after_freeze": {"const": false},
        "contains_source_text": {"const": false},
        "manuscript_eligible": {"const": false}
      },
      "additionalProperties": false
    },
    "routeSeal": {
      "type": "object",
      "required": [
        "document_type",
        "seal_version",
        "route_record_sha256",
        "policy_manifest_sha256",
        "freeze_sha256",
        "item_id",
        "route",
        "sealed_before_specialist_observations",
        "sealed_before_heldout_access",
        "contains_source_text",
        "manuscript_eligible"
      ],
      "properties": {
        "document_type": {"const": "warrantroute_route_seal"},
        "seal_version": {"const": "warrantroute-route-seal-v1"},
        "route_record_sha256": {"$ref": "#/$defs/sha256"},
        "policy_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "freeze_sha256": {"$ref": "#/$defs/sha256"},
        "item_id": {"type": "string", "pattern": "^DJI_[a-f0-9]{16}$"},
        "route": {"enum": ["none", "qualitative_methods", "domain", "both"]},
        "sealed_before_specialist_observations": {"const": true},
        "sealed_before_heldout_access": {"const": true},
        "contains_source_text": {"const": false},
        "manuscript_eligible": {"const": false}
      },
      "additionalProperties": false
    },
    "ratingProjection": {
      "type": "object",
      "required": ["cannot_judge", "serious_error_flags"],
      "properties": {
        "cannot_judge": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "enum": [
              "evidential_credibility",
              "voice_boundary_preservation",
              "scope_calibration"
            ]
          }
        },
        "serious_error_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/flag"}
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "actor_id",
        "prompted_role",
        "model_id",
        "model_snapshot_sha256",
        "rating_repetition",
        "item_id",
        "evaluator_item_sha256",
        "observation_status",
        "rating",
        "observation_sha256"
      ],
      "properties": {
        "actor_id": {
          "enum": [
            "qwen3_8b_researcher_reviewer_v1",
            "qwen3_8b_qualitative_methods_reviewer_v1",
            "qwen3_8b_domain_reviewer_v1"
          ]
        },
        "prompted_role": {"$ref": "#/$defs/role"},
        "model_id": {"const": "qwen3:8b"},
        "model_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "rating_repetition": {"type": "integer", "minimum": 1, "maximum": 3},
        "item_id": {"type": "string", "pattern": "^DJI_[a-f0-9]{16}$"},
        "evaluator_item_sha256": {"$ref": "#/$defs/sha256"},
        "observation_status": {
          "enum": ["valid", "invalid_output", "content_filtered", "timeout", "terminal_failure", "missing"]
        },
        "rating": {
          "oneOf": [
            {"$ref": "#/$defs/ratingProjection"},
            {"type": "null"}
          ]
        },
        "observation_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"observation_status": {"const": "valid"}}, "required": ["observation_status"]},
          "then": {"properties": {"rating": {"$ref": "#/$defs/ratingProjection"}}},
          "else": {"properties": {"rating": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    },
    "observationSet": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/observation"}
    }
  }
}
