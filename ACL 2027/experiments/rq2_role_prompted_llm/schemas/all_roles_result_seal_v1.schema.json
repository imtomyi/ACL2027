{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/all-roles-result-seal-v1.json",
  "title": "Source-free Qwen3 All roles result integrity seal",
  "type": "object",
  "required": [
    "document_type",
    "seal_version",
    "freeze_sha256",
    "input_sha256",
    "fixture_matrix_sha256",
    "result_sha256",
    "external_study_references",
    "external_references_verified",
    "internal_lane",
    "item_count",
    "contains_source_text",
    "result_label",
    "manuscript_eligible"
  ],
  "properties": {
    "document_type": {"const": "rq2_qwen3_all_roles_result_seal"},
    "seal_version": {"const": "rq2-qwen3-all-roles-result-seal-v1"},
    "freeze_sha256": {"$ref": "#/$defs/sha256"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "result_sha256": {"$ref": "#/$defs/sha256"},
    "external_study_references": {
      "$ref": "#/$defs/externalStudyReferences"
    },
    "external_references_verified": {"const": false},
    "internal_lane": {
      "enum": [
        "development_train",
        "in_domain_audit",
        "heldout_cross_domain_evaluation"
      ]
    },
    "item_count": {"type": "integer", "minimum": 1},
    "contains_source_text": {"const": false},
    "result_label": {"const": "diagnostic_not_manuscript_evidence"},
    "manuscript_eligible": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "externalStudyReferences": {
      "type": "object",
      "required": [
        "verification_status",
        "qualification_seal_sha256",
        "eligibility_truth_seal_sha256",
        "review_matrix_seal_sha256"
      ],
      "properties": {
        "verification_status": {
          "const": "not_verified_by_source_free_component"
        },
        "qualification_seal_sha256": {"$ref": "#/$defs/sha256"},
        "eligibility_truth_seal_sha256": {"$ref": "#/$defs/sha256"},
        "review_matrix_seal_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
