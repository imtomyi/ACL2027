{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/qwen3-generalist-verification-seal-v1.json",
  "title": "Independent controlled-error verification seal",
  "type": "object",
  "required": [
    "document_type",
    "seal_version",
    "seal_id",
    "study_id",
    "status",
    "contains_source_text",
    "verification_bundle_sha256",
    "item_count",
    "item_id_set_sha256",
    "all_items_verified",
    "sealed_at_utc",
    "sealed_by_authority_id"
  ],
  "properties": {
    "document_type": {
      "const": "warrantroute_qwen3_generalist_verification_seal"
    },
    "seal_version": {
      "const": "qwen3-generalist-verification-seal-v1"
    },
    "seal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "status": {
      "const": "complete"
    },
    "contains_source_text": {
      "const": false
    },
    "verification_bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "item_count": {
      "type": "integer",
      "minimum": 1
    },
    "item_id_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "all_items_verified": {
      "const": true
    },
    "sealed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "sealed_by_authority_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
