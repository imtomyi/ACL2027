{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/base-generation-v2.json",
  "title": "Positional bounded-base generation",
  "$defs": {
    "role_position_1": {
      "type": "object",
      "required": ["position", "role"],
      "properties": {
        "position": {"const": 1},
        "role": {"enum": ["support", "counterevidence", "context_only"]}
      },
      "additionalProperties": false
    },
    "role_position_2": {
      "type": "object",
      "required": ["position", "role"],
      "properties": {
        "position": {"const": 2},
        "role": {"enum": ["support", "counterevidence", "context_only"]}
      },
      "additionalProperties": false
    },
    "role_position_3": {
      "type": "object",
      "required": ["position", "role"],
      "properties": {
        "position": {"const": 3},
        "role": {"enum": ["support", "counterevidence", "context_only"]}
      },
      "additionalProperties": false
    },
    "role_position_4": {
      "type": "object",
      "required": ["position", "role"],
      "properties": {
        "position": {"const": 4},
        "role": {"enum": ["support", "counterevidence", "context_only"]}
      },
      "additionalProperties": false
    },
    "role_position_5": {
      "type": "object",
      "required": ["position", "role"],
      "properties": {
        "position": {"const": 5},
        "role": {"enum": ["support", "counterevidence", "context_only"]}
      },
      "additionalProperties": false
    },
    "role_position_6": {
      "type": "object",
      "required": ["position", "role"],
      "properties": {
        "position": {"const": 6},
        "role": {"enum": ["support", "counterevidence", "context_only"]}
      },
      "additionalProperties": false
    },
    "role_plan": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"$ref": "#/$defs/role_position_1"},
        {"$ref": "#/$defs/role_position_2"},
        {"$ref": "#/$defs/role_position_3"},
        {"$ref": "#/$defs/role_position_4"},
        {"$ref": "#/$defs/role_position_5"},
        {"$ref": "#/$defs/role_position_6"}
      ],
      "items": false
    },
    "boundary_condition": {
      "type": "object",
      "required": ["counter_position", "text"],
      "properties": {
        "counter_position": {"enum": [1, 2, 3, 4, 5, 6]},
        "text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "generation_schema_version",
        "status",
        "theme_name",
        "claim",
        "explanation",
        "claim_scope",
        "role_plan",
        "boundary_conditions"
      ],
      "properties": {
        "generation_schema_version": {"const": "rq2-base-generation-v2"},
        "status": {"const": "constructed"},
        "theme_name": {"type": "string", "minLength": 1},
        "claim": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1},
        "claim_scope": {"const": "displayed_packet_only"},
        "role_plan": {"$ref": "#/$defs/role_plan"},
        "boundary_conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/boundary_condition"}
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["generation_schema_version", "status", "reason_codes"],
      "properties": {
        "generation_schema_version": {"const": "rq2-base-generation-v2"},
        "status": {"const": "not_constructable"},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "insufficient_independent_support",
              "no_genuine_counterevidence",
              "no_context_only_candidate",
              "cannot_form_packet_bounded_claim",
              "ambiguous_evidence_roles",
              "outside_inference_would_be_required"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
