{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/warrantroute-policy-manifest-v1.json",
  "title": "Prospectively frozen WarrantRoute policy manifest",
  "type": "object",
  "required": [
    "policy_schema_version",
    "policy_id",
    "status",
    "router_formulation",
    "policy_asset",
    "implementation_asset",
    "feature_set",
    "development_projection_sha256",
    "qualification_gate",
    "preprocessing_sha256",
    "regularization_sha256",
    "budget_and_cost_sha256",
    "threshold_rule_sha256",
    "route_values",
    "route_tie_order",
    "inference_failure_action",
    "heldout_accessed_before_freeze",
    "contains_source_text",
    "contains_protected_attributes",
    "manuscript_eligible"
  ],
  "properties": {
    "policy_schema_version": {"const": "warrantroute-policy-manifest-v1"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "status": {"const": "prospectively_frozen"},
    "router_formulation": {"type": "string", "minLength": 1, "maxLength": 128},
    "policy_asset": {"$ref": "#/$defs/asset"},
    "implementation_asset": {"$ref": "#/$defs/asset"},
    "feature_set": {
      "type": "object",
      "required": ["feature_set_id", "feature_set_sha256", "ordered_feature_names"],
      "properties": {
        "feature_set_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "feature_set_sha256": {"$ref": "#/$defs/sha256"},
        "ordered_feature_names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 192,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
        }
      },
      "additionalProperties": false
    },
    "development_projection_sha256": {"$ref": "#/$defs/sha256"},
    "qualification_gate": {
      "type": "object",
      "required": ["file", "sha256", "passed", "admitted_base_count", "accepted_variant_count"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "passed": {"const": true},
        "admitted_base_count": {"type": "integer", "minimum": 1},
        "accepted_variant_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "preprocessing_sha256": {"$ref": "#/$defs/sha256"},
    "regularization_sha256": {"$ref": "#/$defs/sha256"},
    "budget_and_cost_sha256": {"$ref": "#/$defs/sha256"},
    "threshold_rule_sha256": {"$ref": "#/$defs/sha256"},
    "route_values": {"const": ["none", "qualitative_methods", "domain", "both"]},
    "route_tie_order": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["none", "qualitative_methods", "domain", "both"]}
    },
    "inference_failure_action": {"enum": ["block", "none", "both"]},
    "heldout_accessed_before_freeze": {"const": false},
    "contains_source_text": {"const": false},
    "contains_protected_attributes": {"const": false},
    "manuscript_eligible": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "asset": {
      "type": "object",
      "required": ["file", "sha256"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
