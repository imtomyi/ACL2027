{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/construction-verification-v1.json",
  "title": "Blinded local construction verification",
  "type": "object",
  "required": [
    "verification_schema_version",
    "base_status",
    "comparison_clarity",
    "present_flaws",
    "other_material_flaw",
    "single_material_difference",
    "anchors"
  ],
  "properties": {
    "verification_schema_version": {
      "const": "rq2-construction-verification-v1"
    },
    "base_status": {
      "enum": ["warranted", "materially_flawed", "unclear"]
    },
    "comparison_clarity": {
      "enum": ["clear", "unclear"]
    },
    "present_flaws": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "unsupported_evidence",
          "source_concentration",
          "counterevidence_loss",
          "contextual_flattening",
          "unsupported_abstraction"
        ]
      }
    },
    "other_material_flaw": {"type": "boolean"},
    "single_material_difference": {"type": "boolean"},
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flaw_family", "excerpt_ids", "interpretation_fields", "reason_code"],
        "properties": {
          "flaw_family": {
            "enum": [
              "unsupported_evidence",
              "source_concentration",
              "counterevidence_loss",
              "contextual_flattening",
              "unsupported_abstraction"
            ]
          },
          "excerpt_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^EXC_[a-f0-9]{16}$"}
          },
          "interpretation_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["theme_name", "claim", "explanation", "boundary_conditions"]}
          },
          "reason_code": {
            "enum": [
              "cited_excerpt_does_not_support_material_claim",
              "claim_generalizes_beyond_single_evidence_unit",
              "consequential_countercase_qualification_omitted",
              "locally_stated_distinction_collapsed",
              "claim_scope_or_strength_exceeds_displayed_evidence"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
