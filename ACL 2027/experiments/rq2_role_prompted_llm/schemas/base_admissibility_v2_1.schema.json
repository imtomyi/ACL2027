{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/base-admissibility-v2.1.json",
  "title": "Ollama-compatible source-echo-free base admissibility",
  "type": "object",
  "required": [
    "admissibility_schema_version",
    "base_status",
    "checks",
    "readiness",
    "reason_codes"
  ],
  "properties": {
    "admissibility_schema_version": {"enum": ["rq2-base-admissibility-v2.1"]},
    "base_status": {"enum": ["admissible", "materially_flawed", "unclear"]},
    "checks": {
      "type": "object",
      "required": [
        "all_material_claims_warranted",
        "support_roles_accurate",
        "independent_support_units_sufficient",
        "counter_roles_genuine",
        "boundary_links_consequential_and_preserved",
        "claim_scope_packet_bounded",
        "no_outside_facts",
        "no_other_material_flaw"
      ],
      "properties": {
        "all_material_claims_warranted": {"type": "boolean"},
        "support_roles_accurate": {"type": "boolean"},
        "independent_support_units_sufficient": {"type": "boolean"},
        "counter_roles_genuine": {"type": "boolean"},
        "boundary_links_consequential_and_preserved": {"type": "boolean"},
        "claim_scope_packet_bounded": {"type": "boolean"},
        "no_outside_facts": {"type": "boolean"},
        "no_other_material_flaw": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "non_support_anchor",
        "multi_unit_support",
        "consequential_counter",
        "local_distinction",
        "bounded_claim"
      ],
      "properties": {
        "non_support_anchor": {
          "type": "object",
          "required": ["status", "evidence_positions"],
          "properties": {
            "status": {"enum": ["ready", "not_ready", "unclear"]},
            "evidence_positions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
            }
          },
          "additionalProperties": false
        },
        "multi_unit_support": {
          "type": "object",
          "required": ["status", "evidence_positions"],
          "properties": {
            "status": {"enum": ["ready", "not_ready", "unclear"]},
            "evidence_positions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
            }
          },
          "additionalProperties": false
        },
        "consequential_counter": {
          "type": "object",
          "required": ["status", "evidence_positions"],
          "properties": {
            "status": {"enum": ["ready", "not_ready", "unclear"]},
            "evidence_positions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
            }
          },
          "additionalProperties": false
        },
        "local_distinction": {
          "type": "object",
          "required": ["status", "evidence_positions"],
          "properties": {
            "status": {"enum": ["ready", "not_ready", "unclear"]},
            "evidence_positions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
            }
          },
          "additionalProperties": false
        },
        "bounded_claim": {
          "type": "object",
          "required": ["status", "evidence_positions"],
          "properties": {
            "status": {"enum": ["ready", "not_ready", "unclear"]},
            "evidence_positions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "material_claim_not_warranted",
          "support_role_mismatch",
          "independent_support_units_insufficient",
          "counterevidence_not_genuine",
          "boundary_condition_not_consequential_or_preserved",
          "claim_scope_not_packet_bounded",
          "outside_fact_or_overreach",
          "other_material_flaw",
          "insufficient_displayed_information"
        ]
      }
    }
  },
  "additionalProperties": false
}
