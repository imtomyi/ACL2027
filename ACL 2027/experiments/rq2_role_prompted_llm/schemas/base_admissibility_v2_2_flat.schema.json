{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/base-admissibility-flat-v2.2.json",
  "title": "Flat Ollama transport for source-echo-free base admissibility",
  "type": "object",
  "required": [
    "transport_schema_version",
    "base_status",
    "check_all_material_claims_warranted",
    "check_support_roles_accurate",
    "check_independent_support_units_sufficient",
    "check_counter_roles_genuine",
    "check_boundary_links_consequential_and_preserved",
    "check_claim_scope_packet_bounded",
    "check_no_outside_facts",
    "check_no_other_material_flaw",
    "non_support_anchor_status",
    "non_support_anchor_positions",
    "multi_unit_support_status",
    "multi_unit_support_positions",
    "consequential_counter_status",
    "consequential_counter_positions",
    "local_distinction_status",
    "local_distinction_positions",
    "bounded_claim_status",
    "bounded_claim_positions",
    "reason_codes"
  ],
  "properties": {
    "transport_schema_version": {
      "enum": ["rq2-base-admissibility-flat-v2.2"]
    },
    "base_status": {
      "enum": ["admissible", "materially_flawed", "unclear"]
    },
    "check_all_material_claims_warranted": {"type": "boolean"},
    "check_support_roles_accurate": {"type": "boolean"},
    "check_independent_support_units_sufficient": {"type": "boolean"},
    "check_counter_roles_genuine": {"type": "boolean"},
    "check_boundary_links_consequential_and_preserved": {"type": "boolean"},
    "check_claim_scope_packet_bounded": {"type": "boolean"},
    "check_no_outside_facts": {"type": "boolean"},
    "check_no_other_material_flaw": {"type": "boolean"},
    "non_support_anchor_status": {
      "enum": ["ready", "not_ready", "unclear"]
    },
    "non_support_anchor_positions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
    },
    "multi_unit_support_status": {
      "enum": ["ready", "not_ready", "unclear"]
    },
    "multi_unit_support_positions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
    },
    "consequential_counter_status": {
      "enum": ["ready", "not_ready", "unclear"]
    },
    "consequential_counter_positions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
    },
    "local_distinction_status": {
      "enum": ["ready", "not_ready", "unclear"]
    },
    "local_distinction_positions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
    },
    "bounded_claim_status": {
      "enum": ["ready", "not_ready", "unclear"]
    },
    "bounded_claim_positions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "material_claim_not_warranted",
          "support_role_mismatch",
          "independent_support_units_insufficient",
          "counterevidence_not_genuine",
          "boundary_condition_not_consequential_or_preserved",
          "claim_scope_not_packet_bounded",
          "outside_fact_or_overreach",
          "other_material_flaw",
          "insufficient_displayed_information"
        ]
      }
    }
  },
  "additionalProperties": false
}
