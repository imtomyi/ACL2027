{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/qwen3-generalist-truth-cluster-map-v1.json",
  "title": "Qwen3 Generalist private truth and post-cluster map",
  "description": "Coordinator-only metadata that links evaluator items to independently verified controlled errors and opaque complete-post membership hashes. Source text is forbidden.",
  "type": "object",
  "required": [
    "document_type",
    "schema_version",
    "study_id",
    "corpus_id",
    "official_source_split",
    "evaluation_role",
    "cluster_unit",
    "contains_source_text",
    "access",
    "items"
  ],
  "properties": {
    "document_type": {
      "const": "warrantroute_qwen3_generalist_truth_cluster_map"
    },
    "schema_version": {
      "const": "qwen3-generalist-truth-cluster-map-v1"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "corpus_id": {
      "const": "dreaddit"
    },
    "official_source_split": {
      "const": "test"
    },
    "evaluation_role": {
      "const": "in_domain_audit"
    },
    "cluster_unit": {
      "const": "post"
    },
    "contains_source_text": {
      "const": false
    },
    "access": {
      "const": "coordinator_only_until_scoring_lock"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/truthItem"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "errorFamily": {
      "enum": [
        "unsupported_evidence",
        "source_concentration",
        "counterevidence_loss",
        "contextual_flattening",
        "unsupported_abstraction"
      ]
    },
    "requiredFlag": {
      "enum": [
        "unsupported_inference",
        "hidden_source_concentration",
        "lost_negative_case",
        "contextual_flattening",
        "unsupported_abstraction"
      ]
    },
    "postCluster": {
      "type": "object",
      "required": [
        "cluster_id",
        "sampling_frame_member_sha256s",
        "packet_member_sha256s",
        "complete"
      ],
      "properties": {
        "cluster_id": {
          "type": "string",
          "pattern": "^PST_[A-Z0-9]{8,32}$"
        },
        "sampling_frame_member_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "packet_member_sha256s": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "complete": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "truthItem": {
      "type": "object",
      "required": [
        "item_id",
        "packet_id",
        "output_id",
        "base_packet_id",
        "candidate_generator_actor_id",
        "evaluator_item_sha256",
        "error_family",
        "required_flag",
        "verification_record_sha256",
        "controlled_variant_verified",
        "single_target_error_verified",
        "no_second_manipulation_verified",
        "post_clusters"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^DJI_[a-f0-9]{16}$"
        },
        "packet_id": {
          "type": "string",
          "pattern": "^PKT_[A-Z0-9]{8,32}$"
        },
        "output_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "base_packet_id": {
          "type": "string",
          "pattern": "^BASE_[A-Z0-9]{8,32}$"
        },
        "candidate_generator_actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,128}$"
        },
        "evaluator_item_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "error_family": {
          "$ref": "#/$defs/errorFamily"
        },
        "required_flag": {
          "$ref": "#/$defs/requiredFlag"
        },
        "verification_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "controlled_variant_verified": {
          "const": true
        },
        "single_target_error_verified": {
          "const": true
        },
        "no_second_manipulation_verified": {
          "const": true
        },
        "post_clusters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/postCluster"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
