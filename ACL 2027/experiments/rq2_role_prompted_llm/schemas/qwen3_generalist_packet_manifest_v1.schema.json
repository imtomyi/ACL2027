{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/qwen3-generalist-packet-manifest-v1.json",
  "title": "Approved Qwen3 Generalist Dreaddit packet manifest",
  "type": "object",
  "required": [
    "document_type",
    "manifest_version",
    "status",
    "study_id",
    "contains_source_text",
    "corpus_id",
    "official_source_split",
    "evaluation_role",
    "reviewer_actor_id",
    "candidate_generator_actor_id",
    "source_receipt_sha256",
    "source_test_file_sha256",
    "packet_bank_sha256",
    "truth_cluster_map_sha256",
    "privacy_review_log_sha256",
    "item_count",
    "item_id_set_sha256",
    "approved_at_utc",
    "approved_by_authority_id"
  ],
  "properties": {
    "document_type": {
      "const": "warrantroute_qwen3_generalist_packet_manifest"
    },
    "manifest_version": {
      "const": "qwen3-generalist-packet-manifest-v1"
    },
    "status": {
      "const": "approved_for_bound_reviewer_execution"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "contains_source_text": {
      "const": false
    },
    "corpus_id": {
      "const": "dreaddit"
    },
    "official_source_split": {
      "const": "test"
    },
    "evaluation_role": {
      "const": "in_domain_audit"
    },
    "reviewer_actor_id": {
      "const": "qwen3_8b_generalist_reviewer_v1"
    },
    "candidate_generator_actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "source_receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_test_file_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "packet_bank_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "truth_cluster_map_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "privacy_review_log_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "item_count": {
      "type": "integer",
      "minimum": 5
    },
    "item_id_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "approved_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by_authority_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
