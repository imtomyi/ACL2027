{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/reviewer-profile-v1.json",
  "title": "Model-neutral WarrantRoute reviewer profile",
  "type": "object",
  "required": [
    "profile_id",
    "status",
    "provider",
    "model_id",
    "model_manifest_path",
    "model_manifest_sha256",
    "actor_ids",
    "role_prompt_contract",
    "minimum_num_ctx",
    "reviewer_canary_status",
    "source_bearing_execution_allowed",
    "manuscript_eligible"
  ],
  "properties": {
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
    "status": {
      "enum": ["primary_source_free_interface", "adapter_template_unbound"]
    },
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,31}$"},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "model_manifest_path": {"type": "string", "pattern": "^/", "minLength": 2},
    "model_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "actor_ids": {
      "type": "object",
      "required": ["researcher", "qualitative_methods", "domain"],
      "properties": {
        "researcher": {"$ref": "#/$defs/actorId"},
        "qualitative_methods": {"$ref": "#/$defs/actorId"},
        "domain": {"$ref": "#/$defs/actorId"}
      },
      "additionalProperties": false
    },
    "role_prompt_contract": {"const": "shared_role_prompts_v1"},
    "minimum_num_ctx": {"type": "integer", "minimum": 8192, "maximum": 131072},
    "reviewer_canary_status": {
      "enum": ["passed_source_free_interface", "required_before_activation"]
    },
    "source_bearing_execution_allowed": {"const": false},
    "manuscript_eligible": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "actorId": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"}
  }
}
