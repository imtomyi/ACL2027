{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/unsupported-abstraction-edit-v2.json",
  "title": "Atomic unsupported-abstraction edit proposal",
  "$defs": {
    "positions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["edit_schema_version", "status", "patch"],
      "properties": {
        "edit_schema_version": {"const": "rq2-unsupported-abstraction-edit-v2"},
        "status": {"const": "proposed"},
        "patch": {
          "type": "object",
          "required": ["edit_field", "replacement_text", "evidence_positions", "edit_intent_code"],
          "properties": {
            "edit_field": {"const": "claim"},
            "replacement_text": {"type": "string", "minLength": 1},
            "evidence_positions": {"$ref": "#/$defs/positions"},
            "edit_intent_code": {"const": "broaden_claim_exactly_one_unsupported_level"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["edit_schema_version", "status", "reason_codes"],
      "properties": {
        "edit_schema_version": {"const": "rq2-unsupported-abstraction-edit-v2"},
        "status": {"const": "not_constructable"},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "bounded_claim_not_clear",
              "one_level_broadening_not_possible",
              "edit_would_introduce_second_flaw",
              "outside_fact_would_be_required"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
