{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/contextual-flattening-edit-v2.1.json",
  "title": "Ollama-compatible atomic contextual-flattening edit",
  "type": "object",
  "required": ["edit_schema_version", "status", "patch", "reason_codes"],
  "properties": {
    "edit_schema_version": {"enum": ["rq2-contextual-flattening-edit-v2.1"]},
    "status": {"enum": ["proposed", "not_constructable"]},
    "patch": {
      "type": "object",
      "required": [
        "edit_field",
        "boundary_slot",
        "replacement_text",
        "evidence_positions",
        "edit_intent_code"
      ],
      "properties": {
        "edit_field": {
          "enum": ["claim", "explanation", "boundary_condition", "not_applicable"]
        },
        "boundary_slot": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]},
        "replacement_text": {"type": "string", "minLength": 1},
        "evidence_positions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]}
        },
        "edit_intent_code": {
          "enum": [
            "collapse_one_local_noncontradictory_distinction",
            "not_constructed"
          ]
        }
      },
      "additionalProperties": false
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "no_consequential_local_distinction",
          "atomic_replacement_not_possible",
          "edit_would_introduce_second_flaw",
          "distinction_anchor_unclear"
        ]
      }
    }
  },
  "additionalProperties": false
}
