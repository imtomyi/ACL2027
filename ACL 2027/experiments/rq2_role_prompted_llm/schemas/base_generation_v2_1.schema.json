{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/base-generation-v2.1.json",
  "title": "Ollama-compatible positional bounded-base generation",
  "type": "object",
  "required": [
    "generation_schema_version",
    "status",
    "theme_name",
    "claim",
    "explanation",
    "claim_scope",
    "role_plan",
    "boundary_conditions",
    "reason_codes"
  ],
  "properties": {
    "generation_schema_version": {"enum": ["rq2-base-generation-v2.1"]},
    "status": {"enum": ["constructed", "not_constructable"]},
    "theme_name": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "explanation": {"type": "string", "minLength": 1},
    "claim_scope": {"enum": ["displayed_packet_only", "not_constructed"]},
    "role_plan": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["position", "role"],
        "properties": {
          "position": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]},
          "role": {
            "enum": ["support", "counterevidence", "context_only", "unassigned"]
          }
        },
        "additionalProperties": false
      }
    },
    "boundary_conditions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["counter_position", "text"],
        "properties": {
          "counter_position": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6]},
          "text": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "insufficient_independent_support",
          "no_genuine_counterevidence",
          "no_context_only_candidate",
          "cannot_form_packet_bounded_claim",
          "ambiguous_evidence_roles",
          "outside_inference_would_be_required"
        ]
      }
    }
  },
  "additionalProperties": false
}
