{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "warrantroute_playbook_bullet_v1.schema.json",
  "title": "WarrantRoute Playbook Bullet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bullet_id",
    "section",
    "scope",
    "dataset_scope",
    "trigger",
    "rule",
    "required_checks",
    "failure_modes",
    "exceptions",
    "agent_targets",
    "provenance",
    "status",
    "version",
    "approved_by",
    "helpful_count",
    "harmful_count"
  ],
  "properties": {
    "bullet_id": {
      "type": "string",
      "pattern": "^pb-[a-z]+-[0-9]{4}$"
    },
    "section": {
      "enum": [
        "analytic_contract",
        "evidence_warrant",
        "negative_cases",
        "theme_construction",
        "codebook_consistency",
        "domain_safety",
        "contextual_boundary",
        "revision_quality",
        "reporting",
        "abstention"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "dataset_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["all", "dreaddit", "goemotions", "agyw_focus_groups", "parlamint_gb"]
      }
    },
    "trigger": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "rule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_:-]+$"
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fabricated_or_altered_quote",
          "wrong_attribution",
          "unsupported_inference",
          "hidden_source_concentration",
          "lost_negative_case",
          "contextual_flattening",
          "unsupported_abstraction",
          "sensitive_or_diagnostic_inference",
          "inconsistent_codebook",
          "other"
        ]
      }
    },
    "exceptions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 240
      }
    },
    "agent_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["proposer", "evidence_scout", "methods_challenger", "domain_challenger", "reviser"]
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    },
    "status": {
      "enum": ["candidate", "active", "deprecated", "contradiction_hold"]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "approved_by": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "helpful_count": {
      "type": "integer",
      "minimum": 0
    },
    "harmful_count": {
      "type": "integer",
      "minimum": 0
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
