{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://warrantroute.local/schemas/rq2/all-roles-result-v1.json",
  "title": "Qwen3 All roles analysis result",
  "type": "object",
  "required": [
    "document_type",
    "analysis_version",
    "study_id",
    "lane",
    "reviewer_model",
    "role_order",
    "aggregation_rule",
    "primary_repetition",
    "stability_rule",
    "input_sha256",
    "fixture_matrix_sha256",
    "external_study_references",
    "external_references_verified",
    "item_count",
    "primary_summary",
    "stability_summary",
    "bootstrap",
    "primary_interval",
    "stability_interval",
    "items",
    "descriptive_reference",
    "contains_source_text",
    "result_label",
    "manuscript_eligible"
  ],
  "properties": {
    "document_type": {"const": "rq2_qwen3_all_roles_result"},
    "analysis_version": {"const": "rq2-qwen3-all-roles-analysis-v1"},
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "lane": {"$ref": "#/$defs/lane"},
    "reviewer_model": {
      "type": "object",
      "required": ["model_id", "model_snapshot_sha256"],
      "properties": {
        "model_id": {"const": "qwen3:8b"},
        "model_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "role_order": {
      "const": ["researcher", "qualitative_methods", "domain"]
    },
    "aggregation_rule": {"const": "union_across_roles"},
    "primary_repetition": {"const": 1},
    "stability_rule": {
      "const": "two_of_three_within_role_then_union_across_roles"
    },
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "external_study_references": {
      "$ref": "#/$defs/externalStudyReferences"
    },
    "external_references_verified": {"const": false},
    "item_count": {"type": "integer", "minimum": 1},
    "primary_summary": {"$ref": "#/$defs/summary"},
    "stability_summary": {"$ref": "#/$defs/summary"},
    "bootstrap": {"$ref": "#/$defs/bootstrap"},
    "primary_interval": {"$ref": "#/$defs/interval"},
    "stability_interval": {"$ref": "#/$defs/interval"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/itemResult"}
    },
    "descriptive_reference": {"const": true},
    "contains_source_text": {"const": false},
    "result_label": {"const": "diagnostic_not_manuscript_evidence"},
    "manuscript_eligible": {"const": false}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "externalStudyReferences": {
      "type": "object",
      "required": [
        "verification_status",
        "qualification_seal_sha256",
        "eligibility_truth_seal_sha256",
        "review_matrix_seal_sha256"
      ],
      "properties": {
        "verification_status": {
          "const": "not_verified_by_source_free_component"
        },
        "qualification_seal_sha256": {"$ref": "#/$defs/sha256"},
        "eligibility_truth_seal_sha256": {"$ref": "#/$defs/sha256"},
        "review_matrix_seal_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "lane": {
      "oneOf": [
        {
          "const": {
            "corpus": "dreaddit",
            "source_split": "official_train",
            "internal_lane": "development_train",
            "experimental_role": "development_diagnostic",
            "heldout": false
          }
        },
        {
          "const": {
            "corpus": "dreaddit",
            "source_split": "official_test",
            "internal_lane": "in_domain_audit",
            "experimental_role": "post_development_audit_diagnostic",
            "heldout": true
          }
        },
        {
          "const": {
            "corpus": "agyw_focus_groups",
            "source_split": "all_focus_groups",
            "internal_lane": "heldout_cross_domain_evaluation",
            "experimental_role": "heldout_cross_domain_diagnostic",
            "heldout": true
          }
        }
      ]
    },
    "roleHits": {
      "type": "object",
      "required": ["researcher", "qualitative_methods", "domain"],
      "properties": {
        "researcher": {"type": "boolean"},
        "qualitative_methods": {"type": "boolean"},
        "domain": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["tp", "fn", "n", "recall"],
      "properties": {
        "tp": {"type": "integer", "minimum": 0},
        "fn": {"type": "integer", "minimum": 0},
        "n": {"type": "integer", "minimum": 1},
        "recall": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "bootstrap": {
      "type": "object",
      "required": [
        "resamples",
        "seed",
        "minimum_independent_clusters",
        "interval",
        "resampling_unit",
        "too_few_or_degenerate_action"
      ],
      "properties": {
        "resamples": {"const": 10000},
        "seed": {"const": 20270826},
        "minimum_independent_clusters": {"const": 5},
        "interval": {"const": "percentile_95"},
        "resampling_unit": {"const": "frozen_source_cluster"},
        "too_few_or_degenerate_action": {"const": "ci_not_estimable"}
      },
      "additionalProperties": false
    },
    "interval": {
      "type": "object",
      "required": [
        "estimable",
        "reason",
        "lower",
        "upper",
        "cluster_count",
        "minimum_independent_clusters",
        "resamples",
        "seed"
      ],
      "properties": {
        "estimable": {"type": "boolean"},
        "reason": {
          "type": ["string", "null"],
          "enum": [
            null,
            "fewer_than_minimum_independent_clusters",
            "degenerate_bootstrap_distribution"
          ]
        },
        "lower": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "upper": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "cluster_count": {"type": "integer", "minimum": 1},
        "minimum_independent_clusters": {"const": 5},
        "resamples": {"const": 10000},
        "seed": {"const": 20270826}
      },
      "allOf": [
        {
          "if": {
            "properties": {"estimable": {"const": true}},
            "required": ["estimable"]
          },
          "then": {
            "properties": {
              "reason": {"type": "null"},
              "lower": {"type": "number"},
              "upper": {"type": "number"}
            }
          },
          "else": {
            "properties": {
              "reason": {"type": "string"},
              "lower": {"type": "null"},
              "upper": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "itemResult": {
      "type": "object",
      "required": [
        "item_id",
        "cluster_id",
        "error_family",
        "required_flag",
        "fixture_observation_hashes",
        "primary_role_flags",
        "primary_role_hits",
        "primary_all_roles_flags",
        "primary_all_roles_hit",
        "stability_role_hits",
        "stability_role_flags",
        "stability_all_roles_flags",
        "stability_all_roles_hit"
      ],
      "properties": {
        "item_id": {"type": "string", "pattern": "^DJI_[a-f0-9]{16}$"},
        "cluster_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "error_family": {
          "enum": [
            "unsupported_evidence",
            "source_concentration",
            "counterevidence_loss",
            "contextual_flattening",
            "unsupported_abstraction"
          ]
        },
        "required_flag": {
          "enum": [
            "unsupported_inference",
            "hidden_source_concentration",
            "lost_negative_case",
            "contextual_flattening",
            "unsupported_abstraction"
          ]
        },
        "fixture_observation_hashes": {"$ref": "#/$defs/roleObservationHashes"},
        "primary_role_flags": {"$ref": "#/$defs/roleFlags"},
        "primary_role_hits": {"$ref": "#/$defs/roleHits"},
        "primary_all_roles_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/allErrorFlag"}
        },
        "primary_all_roles_hit": {"type": "boolean"},
        "stability_role_hits": {"$ref": "#/$defs/roleHits"},
        "stability_role_flags": {"$ref": "#/$defs/roleFlags"},
        "stability_all_roles_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/allErrorFlag"}
        },
        "stability_all_roles_hit": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "roleObservationHashes": {
      "type": "object",
      "required": ["researcher", "qualitative_methods", "domain"],
      "properties": {
        "researcher": {"$ref": "#/$defs/threeHashes"},
        "qualitative_methods": {"$ref": "#/$defs/threeHashes"},
        "domain": {"$ref": "#/$defs/threeHashes"}
      },
      "additionalProperties": false
    },
    "roleFlags": {
      "type": "object",
      "required": ["researcher", "qualitative_methods", "domain"],
      "properties": {
        "researcher": {"$ref": "#/$defs/errorFlagSet"},
        "qualitative_methods": {"$ref": "#/$defs/errorFlagSet"},
        "domain": {"$ref": "#/$defs/errorFlagSet"}
      },
      "additionalProperties": false
    },
    "errorFlagSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/allErrorFlag"}
    },
    "threeHashes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "allErrorFlag": {
      "enum": [
        "fabricated_or_altered_quote",
        "wrong_attribution",
        "unsupported_inference",
        "hidden_source_concentration",
        "lost_negative_case",
        "contextual_flattening",
        "unsupported_abstraction",
        "sensitive_or_diagnostic_inference",
        "inconsistent_codebook",
        "other"
      ]
    }
  }
}
