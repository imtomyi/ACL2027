# Copy to portkey.local.env. Never commit the local file or an actual key.
PORTKEY_API_KEY=

# Set exactly one. The supplied guide identifies these provider/model pairs:
#   OpenAI:   info-yd4956-ope-01316b / gpt-5.4-mini
#   Anthropic: info-yd4956-anthropic / claude-sonnet-4-5-20250929
# PORTKEY_PROVIDER accepts the Model Catalog slug with or without its leading @.
PORTKEY_PROVIDER=info-yd4956-ope-01316b
PORTKEY_CONFIG=

# Use the exact model identifier accepted by the selected provider/config.
PORTKEY_MODEL=gpt-5.4-mini

PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_TIMEOUT_SECONDS=240

# json_object is the compatibility default. Use json_schema only after the
# selected provider/model passes the explicit probe and experiment canary.
PORTKEY_RESPONSE_FORMAT=json_object

# Hard spending controls. Never set PORTKEY_BUDGET_USD above 100. Use a
# dedicated Portkey API key with a dashboard cost budget of USD 100 and no
# periodic reset. The runner also maintains an atomic local reservation ledger.
PORTKEY_BUDGET_USD=100.00
# After the dashboard hard cap is confirmed, replace NO with:
# I_SET_A_DEDICATED_PORTKEY_KEY_HARD_CAP_TO_100_USD_NO_RESET
PORTKEY_REMOTE_BUDGET_ACK=NO
PORTKEY_RUN_ID=
PORTKEY_BUDGET_LEDGER="/Users/tom/Documents/GitHub/ACL2027/ACL 2027/Storage/portkey_budget/portkey_experiment_budget_v1.json"

# Freeze current input/output prices from the provider or Portkey Model Catalog.
# Units are USD per 1,000,000 tokens. Preflight rejects verification older than
# seven days. Never guess these values.
PORTKEY_INPUT_USD_PER_1M_TOKENS=
PORTKEY_OUTPUT_USD_PER_1M_TOKENS=
PORTKEY_PRICING_VERIFIED_DATE=
PORTKEY_PRICING_SOURCE_URL=
# After verifying both prices, replace NO with:
# I_VERIFIED_CURRENT_MODEL_TOKEN_PRICING
PORTKEY_PRICING_ACK=NO

# Reservations use conservative token upper bounds and a pricing safety margin.
PORTKEY_COST_SAFETY_MULTIPLIER=1.10
PORTKEY_INPUT_OVERHEAD_TOKENS=2048
PORTKEY_OUTPUT_OVERHEAD_TOKENS=256

# External source text must not be sent until this exact value is set after the
# experiment owner has reviewed Portkey logging, retention, and data policy.
# Required value: I_ACKNOWLEDGE_EXTERNAL_TRANSMISSION
PORTKEY_ALLOW_EXTERNAL_DATA=NO
