{
  "document_type": "rq2_construction_comparison_acceptance_rule",
  "rule_version": "rq2-construction-comparison-acceptance-v2",
  "comparison_schema_version": "rq2-construction-comparison-v2",
  "prerequisites": {
    "base_admissibility_rule_passed": true,
    "base_admissibility_artifact_hash_bound": true,
    "family_edit_contract_passed": true,
    "compact_diff_hash_bound": true,
    "target_withheld_from_verifier": true
  },
  "required": {
    "comparison_clarity": "clear",
    "present_flaws_exactly_single_frozen_target": true,
    "other_material_flaw": false,
    "single_material_difference": true,
    "exactly_one_valid_target_anchor": true,
    "uncertainty_codes": []
  },
  "target_reason_codes": {
    "unsupported_evidence": "cited_position_does_not_support_material_claim",
    "source_concentration": "claim_generalizes_beyond_single_cited_unit",
    "counterevidence_loss": "consequential_countercase_qualification_omitted",
    "contextual_flattening": "locally_stated_noncontradictory_distinction_collapsed",
    "unsupported_abstraction": "claim_scope_or_strength_exceeds_displayed_evidence"
  },
  "allowed_anchor_fields": {
    "unsupported_evidence": ["claim", "explanation", "evidence_roles"],
    "source_concentration": ["claim", "explanation", "evidence_roles"],
    "counterevidence_loss": ["boundary_conditions", "evidence_roles"],
    "contextual_flattening": ["claim", "explanation", "boundary_conditions"],
    "unsupported_abstraction": ["claim"]
  },
  "anchor_validation": {
    "positions_must_be_in": [1, 2, 3, 4, 5, 6],
    "positions_must_be_subset_of_family_contract_anchor_positions": true,
    "reason_code_must_equal_target_reason_code": true,
    "fields_must_be_nonempty_subset_of_allowed_anchor_fields": true
  },
  "rejection_reason_codes": [
    "base_admissibility_prerequisite_failed",
    "family_edit_contract_failed",
    "comparison_terminal_failure",
    "comparison_unclear",
    "present_flaws_not_exact_singleton_target",
    "other_material_flaw",
    "not_single_material_difference",
    "target_anchor_invalid",
    "uncertainty_codes_nonempty"
  ],
  "unclear_is_rejected": true,
  "semantic_retry_allowed": false,
  "regeneration_or_replacement_allowed": false,
  "manual_override_allowed": false,
  "verification_label": "frozen_local_model_screened_not_human_ground_truth",
  "metric_label_template": "automated-target recall among {verifier_model}-screened variants",
  "human_ground_truth": false,
  "manuscript_eligible": false,
  "publication_or_release_eligible": false
}
