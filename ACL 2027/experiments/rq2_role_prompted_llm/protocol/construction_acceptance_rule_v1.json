{
  "document_type": "rq2_local_construction_acceptance_rule",
  "rule_version": "rq2-local-construction-acceptance-v1",
  "verifier_is_blinded_to": [
    "target_flaw",
    "construction_note",
    "family_index",
    "truth",
    "reviewer_outputs"
  ],
  "required": {
    "deterministic_structural_invariants_pass": true,
    "base_status": "warranted",
    "comparison_clarity": "clear",
    "present_flaws_exactly_single_frozen_target": true,
    "other_material_flaw": false,
    "single_material_difference": true,
    "exactly_one_valid_target_anchor": true,
    "exact_target_reason_code": true
  },
  "rejected_variants_are_regenerated_or_replaced": false,
  "manual_override_allowed": false,
  "semantic_retry_allowed": false,
  "result_label": "local_model_verified_not_human_ground_truth",
  "metric_label": "automated-target recall among Gemma-screened variants",
  "manuscript_eligible": false,
  "publication_or_release_eligible": false
}
