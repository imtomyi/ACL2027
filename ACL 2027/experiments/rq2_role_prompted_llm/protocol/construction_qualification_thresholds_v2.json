{
  "document_type": "rq2_construction_qualification_thresholds",
  "threshold_version": "rq2-construction-qualification-thresholds-v2",
  "scope": "fresh_dreaddit_development_qualification_only",
  "planned_design": {
    "base_packets": 10,
    "excerpts_per_packet": 6,
    "flaw_families": 5,
    "planned_candidates_per_family": 10,
    "planned_candidates_total": 50,
    "packet_commitments_disjoint_from_v1_development": true,
    "packet_commitments_disjoint_from_heldout_lanes": true,
    "adaptive_sampling_allowed": false,
    "replacement_allowed": false
  },
  "zero_tolerance_failures": {
    "model_identity_or_manifest_drift": 0,
    "policy_or_artifact_integrity_failure": 0,
    "transport_or_truncation_failure": 0,
    "schema_invalid_output": 0,
    "unknown_or_out_of_range_position": 0,
    "deterministic_structural_invariant_failure": 0,
    "source_bearing_output_on_stdout_or_in_aggregate": 0
  },
  "base_gate": {
    "denominator": 10,
    "minimum_admissible_bases": 8,
    "maximum_unclear_bases": 2
  },
  "structural_gate": {
    "required_pass_fraction_of_assembled_candidates": 1.0
  },
  "per_family_comparison_gate": {
    "denominator": 10,
    "maximum_unclear_comparisons": 2,
    "minimum_accepted_variants": 5,
    "minimum_independent_accepted_packet_clusters": 5
  },
  "overall_gate": {
    "denominator": 50,
    "minimum_accepted_variants": 30
  },
  "on_any_gate_failure": {
    "stop_before_reviewer_calls": true,
    "stop_before_fixed_role_selection": true,
    "stop_before_dreaddit_audit": true,
    "stop_before_agyw_heldout": true,
    "write_source_free_funnel_only": true,
    "same_freeze_may_be_revised_and_resumed": false
  },
  "on_all_gates_pass": {
    "seal_all_prompt_schema_rule_model_and_threshold_hashes": true,
    "heldout_protocol_changes_allowed_after_seal": false,
    "proceed_to_reviewer_and_heldout_stages_only_under_separate_bound_freeze": true
  },
  "semantic_retry_allowed": false,
  "regeneration_or_replacement_allowed": false,
  "manual_override_allowed": false,
  "qualification_is_an_rq2_performance_result": false,
  "human_ground_truth": false,
  "manuscript_eligible": false
}
